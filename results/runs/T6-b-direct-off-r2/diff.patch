@@ -0,0 +1,206 @@
+import { describe, expect, it } from "vitest";
+import { type Clock, fixedClock, InMemoryEventBus } from "../kernel";
+import {
+  type ConsentChannel,
+  createIdentity,
+  InMemoryConsentRepository,
+  InMemoryPersonRepository,
+  InvalidConsentError,
+  UnknownPersonError,
+} from "./index";
+
+/** A clock the test moves forward. */
+function steppingClock(iso: string): Clock & { set(iso: string): void } {
+  let current = fixedClock(iso);
+  return {
+    now: () => current.now(),
+    set(next: string) {
+      current = fixedClock(next);
+    },
+  };
+}
+
+async function setup() {
+  const bus = new InMemoryEventBus();
+  const consents = new InMemoryConsentRepository();
+  const clock = steppingClock("2027-01-05T08:00:00Z");
+  const identity = createIdentity({
+    repo: new InMemoryPersonRepository(),
+    consents,
+    bus,
+    clock,
+  });
+  const person = await identity.registerPerson({
+    email: "erika@example.test",
+    givenName: "Erika",
+    familyName: "Muster",
+  });
+  bus.published.length = 0;
+  return { bus, clock, consents, identity, person };
+}
+
+describe("identity consents", () => {
+  it("T3-AC-004: records the person, purpose, text version, channel, decision and time", async () => {
+    const { identity, person } = await setup();
+    const record = await identity.recordConsent({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+    });
+    expect(record).toMatchObject({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+      decidedAt: "2027-01-05T08:00:00.000Z",
+    });
+    expect(record.id).toMatch(/^[0-9a-f-]{36}$/);
+  });
+
+  it("T3-AC-004: accepts the channels web, advisor and import", async () => {
+    const { identity, person } = await setup();
+    for (const channel of ["web", "advisor", "import"] as const) {
+      const record = await identity.recordConsent({
+        personId: person.id,
+        purpose: "marketing-email",
+        textVersion: "2027-01",
+        channel,
+        granted: true,
+      });
+      expect(record.channel).toBe(channel);
+    }
+    await expect(
+      identity.recordConsent({
+        personId: person.id,
+        purpose: "marketing-email",
+        textVersion: "2027-01",
+        channel: "phone" as ConsentChannel,
+        granted: true,
+      }),
+    ).rejects.toBeInstanceOf(InvalidConsentError);
+  });
+
+  it("T3-AC-004: a withdrawal adds a record and keeps the earlier one unchanged", async () => {
+    const { clock, identity, person } = await setup();
+    const given = await identity.recordConsent({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+    });
+    const givenCopy = { ...given };
+    clock.set("2027-03-28T01:30:00Z");
+    const withdrawn = await identity.recordConsent({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "advisor",
+      granted: false,
+    });
+
+    expect(await identity.consentHistory(person.id)).toEqual([givenCopy, withdrawn]);
+    expect(await identity.currentConsent(person.id, "marketing-email")).toEqual(withdrawn);
+  });
+
+  it("T3-AC-004: a stored record cannot be changed", async () => {
+    const { identity, person } = await setup();
+    await identity.recordConsent({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+    });
+    const [stored] = await identity.consentHistory(person.id);
+    expect(() => {
+      (stored as { granted: boolean }).granted = false;
+    }).toThrow(TypeError);
+    expect((await identity.currentConsent(person.id, "marketing-email"))?.granted).toBe(true);
+  });
+
+  it("returns the current decision per purpose, or null", async () => {
+    const { identity, person } = await setup();
+    await identity.recordConsent({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+    });
+    const analytics = await identity.recordConsent({
+      personId: person.id,
+      purpose: "web-analytics",
+      textVersion: "v3",
+      channel: "web",
+      granted: false,
+    });
+    expect(await identity.currentConsent(person.id, "web-analytics")).toEqual(analytics);
+    expect((await identity.currentConsent(person.id, "marketing-email"))?.granted).toBe(true);
+    expect(await identity.currentConsent(person.id, "newsletter")).toBeNull();
+  });
+
+  it("fails for an unknown person and records nothing", async () => {
+    const { bus, consents, identity } = await setup();
+    const unknown = "0190a000-0000-7000-8000-000000000000";
+    await expect(
+      identity.recordConsent({
+        personId: unknown,
+        purpose: "marketing-email",
+        textVersion: "2027-01",
+        channel: "web",
+        granted: true,
+      }),
+    ).rejects.toBeInstanceOf(UnknownPersonError);
+    expect(await consents.listByPerson(unknown)).toEqual([]);
+    expect(bus.published).toHaveLength(0);
+  });
+
+  it("rejects an empty purpose or text version", async () => {
+    const { identity, person } = await setup();
+    const base = {
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web" as const,
+      granted: true,
+    };
+    await expect(identity.recordConsent({ ...base, purpose: " " })).rejects.toBeInstanceOf(
+      InvalidConsentError,
+    );
+    await expect(identity.recordConsent({ ...base, textVersion: "" })).rejects.toBeInstanceOf(
+      InvalidConsentError,
+    );
+  });
+
+  it("publishes identity.consent-changed with IDs only for each decision", async () => {
+    const { bus, identity, person } = await setup();
+    const given = await identity.recordConsent({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+    });
+    const withdrawn = await identity.recordConsent({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: false,
+    });
+    expect(bus.published.map((e) => [e.type, e.payload])).toEqual([
+      [
+        "identity.consent-changed",
+        { consentId: given.id, personId: person.id, purpose: "marketing-email" },
+      ],
+      [
+        "identity.consent-changed",
+        { consentId: withdrawn.id, personId: person.id, purpose: "marketing-email" },
+      ],
+    ]);
+  });
+});
