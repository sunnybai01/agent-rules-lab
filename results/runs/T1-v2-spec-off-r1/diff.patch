+export class InvalidDateOfBirthError extends Error {
+  constructor(reason: string) {
+    super(`Invalid date of birth: ${reason}`);
+    this.name = "InvalidDateOfBirthError";
+  }
+}
+
+/** A real calendar date in `YYYY-MM-DD`, not after `today` (also `YYYY-MM-DD`). */
+function checkDateOfBirth(value: string, today: string): string {
+  const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(value);
+  const date = match ? new Date(`${value}T00:00:00Z`) : null;
+  if (!date || Number.isNaN(date.getTime()) || date.toISOString().slice(0, 10) !== value) {
+    throw new InvalidDateOfBirthError("expected an ISO date YYYY-MM-DD");
+  }
+  if (value > today) throw new InvalidDateOfBirthError("the date is in the future");
+  return value;
+}
