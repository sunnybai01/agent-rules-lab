@@ -0,0 +1,278 @@
+import { describe, expect, it } from "vitest";
+import { type Clock, InMemoryEventBus } from "../kernel";
+import {
+  createIdentity,
+  InMemoryConsentRepository,
+  InMemoryPersonRepository,
+  InvalidConsentError,
+  UnknownPersonError,
+} from "./index";
+
+/** A clock that the test moves forward. */
+function steppingClock(startIso: string) {
+  let current = new Date(startIso);
+  const clock: Clock & { set(iso: string): void } = {
+    now: () => new Date(current),
+    set(iso: string) {
+      current = new Date(iso);
+    },
+  };
+  return clock;
+}
+
+async function setup() {
+  const bus = new InMemoryEventBus();
+  const consents = new InMemoryConsentRepository();
+  const clock = steppingClock("2027-01-05T08:00:00Z");
+  const identity = createIdentity({
+    repo: new InMemoryPersonRepository(),
+    consents,
+    bus,
+    clock,
+  });
+  const person = await identity.registerPerson({
+    email: "erika@example.test",
+    givenName: "Erika",
+    familyName: "Muster",
+  });
+  bus.published.length = 0;
+  return { bus, clock, consents, identity, person };
+}
+
+describe("identity consents", () => {
+  it("T3-AC-004: stores person, purpose, text version, channel, decision and time", async () => {
+    const { identity, person } = await setup();
+    const record = await identity.recordConsent({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+    });
+    expect(record).toMatchObject({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+      decidedAt: "2027-01-05T08:00:00.000Z",
+    });
+    expect(record.id).toEqual(expect.any(String));
+  });
+
+  it("T3-AC-004: accepts the channels web, advisor and import, and rejects others", async () => {
+    const { identity, person } = await setup();
+    for (const channel of ["web", "advisor", "import"] as const) {
+      const record = await identity.recordConsent({
+        personId: person.id,
+        purpose: "marketing-email",
+        textVersion: "2027-01",
+        channel,
+        granted: true,
+      });
+      expect(record.channel).toBe(channel);
+    }
+    await expect(
+      identity.recordConsent({
+        personId: person.id,
+        purpose: "marketing-email",
+        textVersion: "2027-01",
+        channel: "phone" as never,
+        granted: true,
+      }),
+    ).rejects.toBeInstanceOf(InvalidConsentError);
+  });
+
+  it("T3-AC-004: rejects an empty purpose or text version", async () => {
+    const { identity, person } = await setup();
+    const base = {
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+    } as const;
+    await expect(identity.recordConsent({ ...base, purpose: " " })).rejects.toBeInstanceOf(
+      InvalidConsentError,
+    );
+    await expect(identity.recordConsent({ ...base, textVersion: "" })).rejects.toBeInstanceOf(
+      InvalidConsentError,
+    );
+  });
+
+  it("T3-AC-004: fails for an unknown person and stores nothing", async () => {
+    const { bus, consents, identity } = await setup();
+    await expect(
+      identity.recordConsent({
+        personId: "0190a000-0000-7000-8000-000000000000",
+        purpose: "marketing-email",
+        textVersion: "2027-01",
+        channel: "web",
+        granted: true,
+      }),
+    ).rejects.toBeInstanceOf(UnknownPersonError);
+    expect(await consents.findByPerson("0190a000-0000-7000-8000-000000000000")).toEqual([]);
+    expect(bus.published).toHaveLength(0);
+  });
+
+  it("T3-AC-004: a withdrawal adds a record and keeps the earlier one unchanged", async () => {
+    const { clock, identity, person } = await setup();
+    const given = await identity.recordConsent({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+    });
+    const givenCopy = structuredClone(given);
+    clock.set("2027-02-10T15:30:00Z");
+    const withdrawn = await identity.recordConsent({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "advisor",
+      granted: false,
+    });
+
+    expect(withdrawn.id).not.toBe(given.id);
+    expect(withdrawn).toMatchObject({ granted: false, decidedAt: "2027-02-10T15:30:00.000Z" });
+    const history = await identity.consentHistory(person.id);
+    expect(history).toEqual([givenCopy, withdrawn]);
+  });
+
+  it("T3-AC-004: a returned record cannot change the stored record", async () => {
+    const { identity, person } = await setup();
+    const record = await identity.recordConsent({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+    });
+    expect(() => {
+      (record as { granted: boolean }).granted = false;
+    }).toThrow(TypeError);
+    const [stored] = await identity.consentHistory(person.id);
+    expect(stored?.granted).toBe(true);
+  });
+
+  it("T3-AC-004: the consent store offers no update or delete", () => {
+    const store = new InMemoryConsentRepository() as unknown as Record<string, unknown>;
+    for (const name of ["update", "delete", "remove", "save", "upsert"]) {
+      expect(store[name]).toBeUndefined();
+    }
+  });
+
+  it("T3-AC-004: currentConsent returns the latest record per purpose, or null", async () => {
+    const { clock, identity, person } = await setup();
+    expect(await identity.currentConsent(person.id, "marketing-email")).toBeNull();
+
+    await identity.recordConsent({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+    });
+    clock.set("2027-01-06T08:00:00Z");
+    const profiling = await identity.recordConsent({
+      personId: person.id,
+      purpose: "profiling",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+    });
+    clock.set("2027-01-07T08:00:00Z");
+    const withdrawn = await identity.recordConsent({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-02",
+      channel: "web",
+      granted: false,
+    });
+
+    expect(await identity.currentConsent(person.id, "marketing-email")).toEqual(withdrawn);
+    expect(await identity.currentConsent(person.id, "profiling")).toEqual(profiling);
+    expect(await identity.currentConsent(person.id, "sms")).toBeNull();
+  });
+
+  it("T3-AC-004: currentConsent takes the last record when two decisions share a time", async () => {
+    const { identity, person } = await setup();
+    await identity.recordConsent({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+    });
+    const second = await identity.recordConsent({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: false,
+    });
+    expect(await identity.currentConsent(person.id, "marketing-email")).toEqual(second);
+  });
+
+  it("T3-AC-004: consentHistory returns all records of the person, oldest first", async () => {
+    const { clock, identity, person } = await setup();
+    const other = await identity.registerPerson({
+      email: "max@example.test",
+      givenName: "Max",
+      familyName: "Beispiel",
+    });
+    const first = await identity.recordConsent({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "import",
+      granted: true,
+    });
+    await identity.recordConsent({
+      personId: other.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+    });
+    clock.set("2027-03-28T01:30:00Z");
+    const second = await identity.recordConsent({
+      personId: person.id,
+      purpose: "profiling",
+      textVersion: "2027-01",
+      channel: "advisor",
+      granted: false,
+    });
+
+    expect(await identity.consentHistory(person.id)).toEqual([first, second]);
+    expect(await identity.consentHistory("0190a000-0000-7000-8000-000000000000")).toEqual([]);
+  });
+
+  it("publishes identity.consent-changed with IDs only, after the write", async () => {
+    const { bus, consents, identity, person } = await setup();
+    let storedWhenPublished = 0;
+    bus.subscribe("identity.consent-changed", async () => {
+      storedWhenPublished = (await consents.findByPerson(person.id)).length;
+    });
+    const record = await identity.recordConsent({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+    });
+    expect(bus.published).toHaveLength(1);
+    expect(bus.published[0]).toMatchObject({
+      type: "identity.consent-changed",
+      occurredAt: "2027-01-05T08:00:00.000Z",
+      payload: { consentId: record.id, personId: person.id, purpose: "marketing-email" },
+    });
+    expect(Object.keys(bus.published[0]?.payload as object).sort()).toEqual([
+      "consentId",
+      "personId",
+      "purpose",
+    ]);
+    expect(storedWhenPublished).toBe(1);
+  });
+});
