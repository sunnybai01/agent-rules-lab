+
+  it("AN-903: finds the task of a person and kind, or null", async () => {
+    const repo = new InMemoryTaskRepository();
+    const journey = createJourney({
+      repo,
+      bus: new InMemoryEventBus(),
+      clock: fixedClock("2027-01-05T08:00:00Z"),
+    });
+    const call = await journey.createTask({ personId: "p1", kind: "call", title: "Call" });
+    await journey.createTask({ personId: "p2", kind: "welcome-call", title: "Welcome call" });
+    expect(await repo.findByPersonAndKind("p1", "call")).toEqual(call);
+    expect(await repo.findByPersonAndKind("p1", "welcome-call")).toBeNull();
+  });
 });
