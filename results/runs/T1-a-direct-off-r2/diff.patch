+  }
+}
+
+const isoDatePattern = /^\d{4}-\d{2}-\d{2}$/;
+
+/** Checks that the value is a calendar date as YYYY-MM-DD and not after today in the business time zone. */
+function checkDateOfBirth(value: string, today: string): string {
+  // A rolled-over date such as 2001-02-30 does not survive the round trip.
+  const parsed = new Date(`${value}T00:00:00Z`);
+  const isCalendarDate =
+    isoDatePattern.test(value) &&
+    !Number.isNaN(parsed.getTime()) &&
+    parsed.toISOString().slice(0, 10) === value;
+  if (!isCalendarDate) {
+    throw new InvalidDateOfBirthError("expected a calendar date as YYYY-MM-DD");
+  }
+  // ISO dates of the same format compare correctly as strings.
+  if (value > today) throw new InvalidDateOfBirthError("the date is in the future");
+  return value;
+}
