--- /dev/null
+++ b/packages/core/src/identity/consent.ts
@@ -0,0 +1,41 @@
+import type { DomainEvent } from "../kernel";
+
+export const CONSENT_CHANNELS = ["web", "advisor", "import"] as const;
+export type ConsentChannel = (typeof CONSENT_CHANNELS)[number];
+
+/** One consent decision (T3-AC-004). Never changed or deleted; a new decision adds a record. */
+export interface ConsentRecord {
+  readonly id: string;
+  readonly personId: string;
+  readonly purpose: string;
+  readonly textVersion: string;
+  readonly channel: ConsentChannel;
+  readonly granted: boolean;
+  readonly decidedAt: string;
+}
+
+export type ConsentChanged = DomainEvent<
+  "identity.consent-changed",
+  { consentId: string; personId: string; purpose: string }
+>;
+
+/** Append-only storage of consent records. It has no update and no delete (T3-AC-004). */
+export interface ConsentRepository {
+  append(record: ConsentRecord): Promise<void>;
+  /** All records of the person, oldest first. */
+  listByPerson(personId: string): Promise<ConsentRecord[]>;
+}
+
+export class InMemoryConsentRepository implements ConsentRepository {
+  private readonly rows: ConsentRecord[] = [];
+
+  async append(record: ConsentRecord): Promise<void> {
+    this.rows.push(record);
+  }
+
+  async listByPerson(personId: string): Promise<ConsentRecord[]> {
+    return this.rows
+      .filter((record) => record.personId === personId)
+      .sort((a, b) => a.decidedAt.localeCompare(b.decidedAt));
+  }
+}
