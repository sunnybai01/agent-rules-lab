@@ -0,0 +1,160 @@
+import { describe, expect, it } from "vitest";
+import { type Clock, InMemoryEventBus } from "../kernel";
+import {
+  createIdentity,
+  InMemoryConsentRepository,
+  InMemoryPersonRepository,
+  UnknownPersonError,
+} from "./index";
+
+function steppingClock(start: string): Clock & { advance(ms: number): void } {
+  let current = new Date(start).getTime();
+  return {
+    now: () => new Date(current),
+    advance(ms: number) {
+      current += ms;
+    },
+  };
+}
+
+async function setup() {
+  const bus = new InMemoryEventBus();
+  const clock = steppingClock("2027-01-05T08:00:00Z");
+  const consents = new InMemoryConsentRepository();
+  const identity = createIdentity({
+    repo: new InMemoryPersonRepository(),
+    consents,
+    bus,
+    clock,
+  });
+  const person = await identity.registerPerson({
+    email: "erika@example.test",
+    givenName: "Erika",
+    familyName: "Muster",
+  });
+  bus.published.length = 0;
+  return { bus, clock, consents, identity, person };
+}
+
+describe("identity consents", () => {
+  it("T3-AC-004: stores person, purpose, text version, channel, decision and time", async () => {
+    const { identity, person } = await setup();
+    const record = await identity.recordConsent({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+    });
+    expect(record).toMatchObject({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+      decidedAt: "2027-01-05T08:00:00.000Z",
+    });
+    expect(record.id).toEqual(expect.any(String));
+  });
+
+  it("T3-AC-004: a withdrawal adds a record and keeps the earlier one unchanged", async () => {
+    const { clock, identity, person } = await setup();
+    const given = await identity.recordConsent({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+    });
+    clock.advance(60_000);
+    const withdrawn = await identity.recordConsent({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "advisor",
+      granted: false,
+    });
+    expect(await identity.currentConsent(person.id, "marketing-email")).toEqual(withdrawn);
+    expect(await identity.consentHistory(person.id)).toEqual([given, withdrawn]);
+  });
+
+  it("T3-AC-004: history is oldest first across purposes", async () => {
+    const { clock, identity, person } = await setup();
+    const first = await identity.recordConsent({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "import",
+      granted: true,
+    });
+    clock.advance(1_000);
+    const second = await identity.recordConsent({
+      personId: person.id,
+      purpose: "newsletter",
+      textVersion: "2027-02",
+      channel: "web",
+      granted: true,
+    });
+    expect(await identity.consentHistory(person.id)).toEqual([first, second]);
+    expect(await identity.currentConsent(person.id, "newsletter")).toEqual(second);
+  });
+
+  it("T3-AC-004: the store has no way to change or delete a record", () => {
+    const methods = Object.getOwnPropertyNames(InMemoryConsentRepository.prototype)
+      .filter((name) => name !== "constructor")
+      .sort();
+    expect(methods).toEqual(["append", "listByPerson"]);
+  });
+
+  it("T3-AC-004: rejects a channel outside web, advisor and import", async () => {
+    const { identity, person } = await setup();
+    await expect(
+      identity.recordConsent({
+        personId: person.id,
+        purpose: "marketing-email",
+        textVersion: "2027-01",
+        channel: "phone" as never,
+        granted: true,
+      }),
+    ).rejects.toThrow(/channel/);
+  });
+
+  it("returns null when no decision exists for the purpose", async () => {
+    const { identity, person } = await setup();
+    expect(await identity.currentConsent(person.id, "marketing-email")).toBeNull();
+    expect(await identity.consentHistory(person.id)).toEqual([]);
+  });
+
+  it("fails for an unknown person and stores nothing", async () => {
+    const { bus, consents, identity } = await setup();
+    const unknownId = "00000000-0000-7000-8000-000000000000";
+    await expect(
+      identity.recordConsent({
+        personId: unknownId,
+        purpose: "marketing-email",
+        textVersion: "2027-01",
+        channel: "web",
+        granted: true,
+      }),
+    ).rejects.toBeInstanceOf(UnknownPersonError);
+    expect(await consents.listByPerson(unknownId)).toEqual([]);
+    expect(bus.published).toHaveLength(0);
+  });
+
+  it("publishes identity.consent-changed with IDs only", async () => {
+    const { bus, identity, person } = await setup();
+    const record = await identity.recordConsent({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+    });
+    expect(bus.published).toHaveLength(1);
+    expect(bus.published[0]).toMatchObject({
+      type: "identity.consent-changed",
+      occurredAt: record.decidedAt,
+      payload: { consentId: record.id, personId: person.id, purpose: "marketing-email" },
+    });
+  });
+});
