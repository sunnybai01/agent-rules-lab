+export class InvalidDateOfBirthError extends Error {
+  constructor(reason: string) {
+    super(`Invalid date of birth: ${reason}`);
+    this.name = "InvalidDateOfBirthError";
+  }
+}
+
+const ISO_DATE = /^(\d{4})-(\d{2})-(\d{2})$/;
+
+/** Checks that the value is a calendar date as YYYY-MM-DD and not after today. */
+function checkDateOfBirth(value: string, today: string): string {
+  const match = ISO_DATE.exec(value);
+  if (!match) throw new InvalidDateOfBirthError("expected YYYY-MM-DD");
+  // Date.UTC rolls over an impossible day, for example 2001-02-30 becomes 2001-03-02.
+  const parsed = new Date(Date.UTC(Number(match[1]), Number(match[2]) - 1, Number(match[3])));
+  if (parsed.toISOString().slice(0, 10) !== value) {
+    throw new InvalidDateOfBirthError("not a calendar date");
+  }
+  // Both are YYYY-MM-DD, so string order is date order.
+  if (value > today) throw new InvalidDateOfBirthError("in the future");
+  return value;
+}
