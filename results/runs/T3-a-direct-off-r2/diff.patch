     expect(await journey.listTasks("p1")).toEqual([task]);
   });
+
+  it("creates a welcome call due on the business date of the registration", async () => {
+    const bus = new InMemoryEventBus();
+    const journey = createJourney({
+      repo: new InMemoryTaskRepository(),
+      bus,
+      clock: fixedClock("2027-01-06T09:00:00Z"),
+    });
+    // 23:30 UTC on 5 January is 00:30 on 6 January in Berlin.
+    await bus.publish({
+      type: "identity.person-registered",
+      id: "e1",
+      occurredAt: "2027-01-05T23:30:00Z",
+      payload: { personId: "p1", brand: "provital" },
+    });
+    const tasks = await journey.listTasks("p1");
+    expect(tasks).toHaveLength(1);
+    expect(tasks[0]).toMatchObject({
+      personId: "p1",
+      kind: "welcome-call",
+      title: "Welcome call",
+      dueDate: "2027-01-06",
+    });
+  });
 });
