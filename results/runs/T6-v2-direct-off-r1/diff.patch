@@ -0,0 +1,205 @@
+import { describe, expect, it } from "vitest";
+import { type Clock, InMemoryEventBus } from "../kernel";
+import {
+  type ConsentChannel,
+  createIdentity,
+  InMemoryConsentRepository,
+  InMemoryPersonRepository,
+  InvalidConsentError,
+  UnknownPersonError,
+} from "./index";
+
+/** A clock that moves one minute forward on each call. */
+function steppingClock(startIso: string): Clock {
+  let next = new Date(startIso).getTime();
+  return {
+    now: () => {
+      const instant = new Date(next);
+      next += 60_000;
+      return instant;
+    },
+  };
+}
+
+async function setup() {
+  const bus = new InMemoryEventBus();
+  const consents = new InMemoryConsentRepository();
+  const identity = createIdentity({
+    repo: new InMemoryPersonRepository(),
+    consents,
+    bus,
+    clock: steppingClock("2027-01-05T08:00:00Z"),
+  });
+  const person = await identity.registerPerson({
+    email: "erika@example.test",
+    givenName: "Erika",
+    familyName: "Muster",
+  });
+  bus.published.length = 0;
+  return { bus, consents, identity, personId: person.id };
+}
+
+describe("identity consents", () => {
+  it("T3-AC-004: stores person, purpose, text version, channel, decision and time", async () => {
+    const { identity, personId } = await setup();
+    const record = await identity.recordConsent({
+      personId,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+    });
+    expect(record).toMatchObject({
+      personId,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+      decidedAt: "2027-01-05T08:01:00.000Z",
+    });
+    expect(record.id).toMatch(/^[0-9a-f-]{36}$/);
+  });
+
+  it("T3-AC-004: accepts the channels web, advisor and import", async () => {
+    const { identity, personId } = await setup();
+    for (const channel of ["web", "advisor", "import"] as const) {
+      const record = await identity.recordConsent({
+        personId,
+        purpose: "marketing-email",
+        textVersion: "2027-01",
+        channel,
+        granted: true,
+      });
+      expect(record.channel).toBe(channel);
+    }
+    await expect(
+      identity.recordConsent({
+        personId,
+        purpose: "marketing-email",
+        textVersion: "2027-01",
+        channel: "phone" as ConsentChannel,
+        granted: true,
+      }),
+    ).rejects.toBeInstanceOf(InvalidConsentError);
+  });
+
+  it("T3-AC-004: a withdrawal adds a record and keeps the earlier one unchanged", async () => {
+    const { identity, personId } = await setup();
+    const given = await identity.recordConsent({
+      personId,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+    });
+    const snapshot = { ...given };
+    const withdrawn = await identity.recordConsent({
+      personId,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "advisor",
+      granted: false,
+    });
+    const history = await identity.consentHistory(personId);
+    expect(history).toEqual([snapshot, withdrawn]);
+    expect(await identity.currentConsent(personId, "marketing-email")).toEqual(withdrawn);
+  });
+
+  it("T3-AC-004: a stored record cannot be changed through the returned objects", async () => {
+    const { identity, personId } = await setup();
+    await identity.recordConsent({
+      personId,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+    });
+    const history = await identity.consentHistory(personId);
+    expect(() => {
+      (history[0] as { granted: boolean }).granted = false;
+    }).toThrow(TypeError);
+    history.pop();
+    expect(await identity.consentHistory(personId)).toHaveLength(1);
+  });
+
+  it("T3-AC-004: returns the current decision per purpose and the history oldest first", async () => {
+    const { identity, personId } = await setup();
+    const marketing = await identity.recordConsent({
+      personId,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+    });
+    const newsletter = await identity.recordConsent({
+      personId,
+      purpose: "advisor-newsletter",
+      textVersion: "v3",
+      channel: "import",
+      granted: false,
+    });
+    expect(await identity.currentConsent(personId, "marketing-email")).toEqual(marketing);
+    expect(await identity.currentConsent(personId, "advisor-newsletter")).toEqual(newsletter);
+    expect(await identity.currentConsent(personId, "sms")).toBeNull();
+    const history = await identity.consentHistory(personId);
+    expect(history.map((r) => r.decidedAt)).toEqual([marketing.decidedAt, newsletter.decidedAt]);
+    expect(await identity.consentHistory("0190a000-0000-7000-8000-000000000000")).toEqual([]);
+  });
+
+  it("T3-AC-004: fails for an unknown person and stores nothing", async () => {
+    const { bus, consents, identity } = await setup();
+    const unknown = "0190a000-0000-7000-8000-000000000000";
+    await expect(
+      identity.recordConsent({
+        personId: unknown,
+        purpose: "marketing-email",
+        textVersion: "2027-01",
+        channel: "web",
+        granted: true,
+      }),
+    ).rejects.toBeInstanceOf(UnknownPersonError);
+    expect(await consents.listByPerson(unknown)).toEqual([]);
+    expect(bus.published).toHaveLength(0);
+  });
+
+  it("T3-AC-004: rejects an empty purpose or text version", async () => {
+    const { identity, personId } = await setup();
+    const base = { personId, channel: "web", granted: true } as const;
+    await expect(
+      identity.recordConsent({ ...base, purpose: " ", textVersion: "2027-01" }),
+    ).rejects.toBeInstanceOf(InvalidConsentError);
+    await expect(
+      identity.recordConsent({ ...base, purpose: "marketing-email", textVersion: "" }),
+    ).rejects.toBeInstanceOf(InvalidConsentError);
+  });
+
+  it("T3-AC-004: publishes identity.consent-changed with IDs only, for each decision", async () => {
+    const { bus, identity, personId } = await setup();
+    const handled: unknown[] = [];
+    bus.subscribe("identity.consent-changed", (e) => {
+      handled.push(e.payload);
+    });
+    const given = await identity.recordConsent({
+      personId,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+    });
+    const withdrawn = await identity.recordConsent({
+      personId,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: false,
+    });
+    expect(handled).toEqual([
+      { consentId: given.id, personId, purpose: "marketing-email" },
+      { consentId: withdrawn.id, personId, purpose: "marketing-email" },
+    ]);
+    expect(bus.published[0]).toMatchObject({
+      type: "identity.consent-changed",
+      occurredAt: given.decidedAt,
+    });
+  });
+});
