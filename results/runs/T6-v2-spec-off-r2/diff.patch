@@ -0,0 +1,170 @@
+import { describe, expect, it } from "vitest";
+import { fixedClock, InMemoryEventBus } from "../kernel";
+import {
+  createIdentity,
+  InMemoryConsentRepository,
+  InMemoryPersonRepository,
+  PersonNotFoundError,
+} from "./index";
+
+async function setup() {
+  const bus = new InMemoryEventBus();
+  const identity = createIdentity({
+    repo: new InMemoryPersonRepository(),
+    consents: new InMemoryConsentRepository(),
+    bus,
+    clock: fixedClock("2027-01-05T08:00:00Z"),
+  });
+  const person = await identity.registerPerson({
+    email: "erika@example.test",
+    givenName: "Erika",
+    familyName: "Muster",
+  });
+  return { bus, identity, person };
+}
+
+describe("identity consent", () => {
+  it("T3-AC-004: records the person, purpose, text version, channel, decision and time", async () => {
+    const { identity, person } = await setup();
+    const record = await identity.recordConsent({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+    });
+    expect(record).toMatchObject({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+      decidedAt: "2027-01-05T08:00:00.000Z",
+    });
+    expect(record.id).toMatch(/^[0-9a-f]{8}-[0-9a-f]{4}-7/);
+  });
+
+  it("T3-AC-004: fails for an unknown person", async () => {
+    const { identity } = await setup();
+    await expect(
+      identity.recordConsent({
+        personId: "0190a000-0000-7000-8000-000000000000",
+        purpose: "marketing-email",
+        textVersion: "2027-01",
+        channel: "web",
+        granted: true,
+      }),
+    ).rejects.toBeInstanceOf(PersonNotFoundError);
+  });
+
+  it("T3-AC-004: rejects an empty purpose, an empty text version and an unknown channel", async () => {
+    const { identity, person } = await setup();
+    const valid = {
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web" as const,
+      granted: true,
+    };
+    await expect(identity.recordConsent({ ...valid, purpose: " " })).rejects.toBeInstanceOf(
+      TypeError,
+    );
+    await expect(identity.recordConsent({ ...valid, textVersion: "" })).rejects.toBeInstanceOf(
+      TypeError,
+    );
+    await expect(
+      identity.recordConsent({ ...valid, channel: "fax" as unknown as "web" }),
+    ).rejects.toBeInstanceOf(TypeError);
+  });
+
+  it("T3-AC-004: a withdrawal adds a record and keeps the earlier one", async () => {
+    const { identity, person } = await setup();
+    const given = { personId: person.id, purpose: "marketing-email", textVersion: "2027-01" };
+    const first = await identity.recordConsent({ ...given, channel: "web", granted: true });
+    const second = await identity.recordConsent({ ...given, channel: "advisor", granted: false });
+    expect(await identity.consentHistory(person.id)).toEqual([first, second]);
+    expect(first.granted).toBe(true);
+  });
+
+  it("T3-AC-004: returned records cannot be changed", async () => {
+    const { identity, person } = await setup();
+    const record = await identity.recordConsent({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+    });
+    expect(Object.isFrozen(record)).toBe(true);
+    const [stored] = await identity.consentHistory(person.id);
+    expect(() => {
+      (stored as { granted: boolean }).granted = false;
+    }).toThrow(TypeError);
+    const history = await identity.consentHistory(person.id);
+    history.pop();
+    expect(await identity.consentHistory(person.id)).toHaveLength(1);
+  });
+
+  it("T3-AC-004: currentConsent returns the latest record for the purpose or null", async () => {
+    const { identity, person } = await setup();
+    const base = { personId: person.id, textVersion: "2027-01", channel: "web" as const };
+    expect(await identity.currentConsent(person.id, "marketing-email")).toBeNull();
+    await identity.recordConsent({ ...base, purpose: "marketing-email", granted: true });
+    const withdrawal = await identity.recordConsent({
+      ...base,
+      purpose: "marketing-email",
+      granted: false,
+    });
+    await identity.recordConsent({ ...base, purpose: "newsletter", granted: true });
+    expect(await identity.currentConsent(person.id, "marketing-email")).toEqual(withdrawal);
+    expect(await identity.currentConsent(person.id, "phone")).toBeNull();
+  });
+
+  it("T3-AC-004: consentHistory returns all records oldest first", async () => {
+    const { identity, person } = await setup();
+    const base = { personId: person.id, textVersion: "2027-01", channel: "web" as const };
+    const a = await identity.recordConsent({ ...base, purpose: "marketing-email", granted: true });
+    const b = await identity.recordConsent({ ...base, purpose: "newsletter", granted: true });
+    const c = await identity.recordConsent({ ...base, purpose: "marketing-email", granted: false });
+    expect(await identity.consentHistory(person.id)).toEqual([a, b, c]);
+    expect(await identity.consentHistory("0190a000-0000-7000-8000-000000000000")).toEqual([]);
+  });
+
+  it("T3-AC-004: publishes identity.consent-recorded with the consent and person IDs", async () => {
+    const { bus, identity, person } = await setup();
+    bus.published.length = 0;
+    const record = await identity.recordConsent({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: false,
+    });
+    expect(bus.published).toHaveLength(1);
+    expect(bus.published[0]).toMatchObject({
+      type: "identity.consent-recorded",
+      occurredAt: "2027-01-05T08:00:00.000Z",
+    });
+    // The decision stays in identity (ADR-0017).
+    expect(bus.published[0]?.payload).toEqual({
+      consentId: record.id,
+      personId: person.id,
+      purpose: "marketing-email",
+    });
+  });
+
+  it("T3-AC-004: publishes no event when the record is rejected", async () => {
+    const { bus, identity, person } = await setup();
+    bus.published.length = 0;
+    await expect(
+      identity.recordConsent({
+        personId: person.id,
+        purpose: "",
+        textVersion: "2027-01",
+        channel: "web",
+        granted: true,
+      }),
+    ).rejects.toBeInstanceOf(TypeError);
+    expect(bus.published).toHaveLength(0);
+  });
+});
