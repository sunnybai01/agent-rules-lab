+import type { DomainEvent } from "../kernel";
+
+export type ConsentChannel = "web" | "advisor" | "import";
+
+export const CONSENT_CHANNELS: readonly ConsentChannel[] = ["web", "advisor", "import"];
+
+/** One consent decision of a person. Never changed or deleted (T3-AC-004). */
+export interface ConsentRecord {
+  readonly id: string;
+  readonly personId: string;
+  readonly purpose: string;
+  readonly textVersion: string;
+  readonly channel: ConsentChannel;
