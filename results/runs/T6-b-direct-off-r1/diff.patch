@@ -0,0 +1,216 @@
+import { describe, expect, it } from "vitest";
+import { type Clock, InMemoryEventBus } from "../kernel";
+import {
+  createIdentity,
+  InMemoryConsentRepository,
+  InMemoryPersonRepository,
+  InvalidConsentError,
+  PersonNotFoundError,
+} from "./index";
+
+/** A clock the test moves forward. */
+function steppingClock(iso: string): Clock & { set(iso: string): void } {
+  let instant = new Date(iso);
+  return {
+    now: () => new Date(instant),
+    set: (next) => {
+      instant = new Date(next);
+    },
+  };
+}
+
+async function setup() {
+  const bus = new InMemoryEventBus();
+  const clock = steppingClock("2027-01-05T08:00:00Z");
+  const consents = new InMemoryConsentRepository();
+  const identity = createIdentity({
+    repo: new InMemoryPersonRepository(),
+    consents,
+    bus,
+    clock,
+  });
+  const person = await identity.registerPerson({
+    email: "erika@example.test",
+    givenName: "Erika",
+    familyName: "Muster",
+  });
+  bus.published.length = 0;
+  return { bus, clock, consents, identity, person };
+}
+
+describe("identity consents", () => {
+  it("T3-AC-004: stores person, purpose, text version, channel, decision and time", async () => {
+    const { identity, person } = await setup();
+    const record = await identity.recordConsent({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+    });
+    expect(record).toMatchObject({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+      decidedAt: "2027-01-05T08:00:00.000Z",
+    });
+    expect(record.id).toMatch(/^[0-9a-f-]{36}$/);
+  });
+
+  it("T3-AC-004: a withdrawal adds a record and keeps the earlier one unchanged", async () => {
+    const { clock, identity, person } = await setup();
+    const given = await identity.recordConsent({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "advisor",
+      granted: true,
+    });
+    clock.set("2027-02-01T10:00:00Z");
+    const withdrawn = await identity.recordConsent({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: false,
+    });
+    expect(withdrawn.id).not.toBe(given.id);
+    expect(await identity.consentHistory(person.id)).toEqual([given, withdrawn]);
+    expect(await identity.currentConsent(person.id, "marketing-email")).toEqual(withdrawn);
+  });
+
+  it("T3-AC-004: a returned record cannot change the stored record", async () => {
+    const { identity, person } = await setup();
+    const record = await identity.recordConsent({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "import",
+      granted: true,
+    });
+    expect(() => {
+      (record as { granted: boolean }).granted = false;
+    }).toThrow(TypeError);
+    const [history] = await identity.consentHistory(person.id);
+    expect(history?.granted).toBe(true);
+  });
+
+  it("T3-AC-004: the repository offers no update or delete", () => {
+    const repo = new InMemoryConsentRepository() as unknown as Record<string, unknown>;
+    expect(repo.update).toBeUndefined();
+    expect(repo.delete).toBeUndefined();
+  });
+
+  it("T3-AC-004: fails for an unknown person and stores nothing", async () => {
+    const { bus, consents, identity } = await setup();
+    const unknown = "01890000-0000-7000-8000-000000000000";
+    await expect(
+      identity.recordConsent({
+        personId: unknown,
+        purpose: "marketing-email",
+        textVersion: "2027-01",
+        channel: "web",
+        granted: true,
+      }),
+    ).rejects.toBeInstanceOf(PersonNotFoundError);
+    expect(await consents.listByPerson(unknown)).toEqual([]);
+    expect(bus.published).toEqual([]);
+  });
+
+  it("T3-AC-004: rejects an unknown channel, an empty purpose and an empty text version", async () => {
+    const { identity, person } = await setup();
+    const valid = {
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web" as const,
+      granted: true,
+    };
+    await expect(
+      identity.recordConsent({ ...valid, channel: "phone" as never }),
+    ).rejects.toBeInstanceOf(InvalidConsentError);
+    await expect(identity.recordConsent({ ...valid, purpose: " " })).rejects.toBeInstanceOf(
+      InvalidConsentError,
+    );
+    await expect(identity.recordConsent({ ...valid, textVersion: "" })).rejects.toBeInstanceOf(
+      InvalidConsentError,
+    );
+    expect(await identity.consentHistory(person.id)).toEqual([]);
+  });
+
+  it("T3-AC-004: current consent is per purpose, null when there is no decision", async () => {
+    const { clock, identity, person } = await setup();
+    expect(await identity.currentConsent(person.id, "marketing-email")).toBeNull();
+    const email = await identity.recordConsent({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+    });
+    clock.set("2027-01-06T08:00:00Z");
+    const analytics = await identity.recordConsent({
+      personId: person.id,
+      purpose: "web-analytics",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: false,
+    });
+    expect(await identity.currentConsent(person.id, "marketing-email")).toEqual(email);
+    expect(await identity.currentConsent(person.id, "web-analytics")).toEqual(analytics);
+  });
+
+  it("T3-AC-004: history is oldest first, also for decisions in the same millisecond", async () => {
+    const { identity, person } = await setup();
+    const first = await identity.recordConsent({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+    });
+    const second = await identity.recordConsent({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: false,
+    });
+    expect(await identity.consentHistory(person.id)).toEqual([first, second]);
+    expect(await identity.currentConsent(person.id, "marketing-email")).toEqual(second);
+  });
+
+  it("T3-AC-004: stores the decision time in UTC across the daylight saving change", async () => {
+    const { clock, identity, person } = await setup();
+    // 2027-03-28 01:30 UTC is 03:30 in Berlin, just after the clocks move forward.
+    clock.set("2027-03-28T01:30:00Z");
+    const record = await identity.recordConsent({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-03",
+      channel: "web",
+      granted: true,
+    });
+    expect(record.decidedAt).toBe("2027-03-28T01:30:00.000Z");
+  });
+
+  it("publishes identity.consent-changed with IDs only, after each decision", async () => {
+    const { bus, identity, person } = await setup();
+    const record = await identity.recordConsent({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+    });
+    expect(bus.published).toHaveLength(1);
+    expect(bus.published[0]).toMatchObject({
+      type: "identity.consent-changed",
+      occurredAt: record.decidedAt,
+      payload: { personId: person.id, consentId: record.id, purpose: "marketing-email" },
+    });
+    expect(bus.published[0]?.payload).not.toHaveProperty("granted");
+  });
+});
