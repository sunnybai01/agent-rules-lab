@@ -0,0 +1,47 @@
+import type { DomainEvent } from "../kernel";
+
+export const CONSENT_CHANNELS = ["web", "advisor", "import"] as const;
+export type ConsentChannel = (typeof CONSENT_CHANNELS)[number];
+
+/** One consent decision (T3-AC-004). Never changed or deleted; a new decision adds a record. */
+export interface Consent {
+  readonly id: string;
+  readonly personId: string;
+  /** What the person consents to, for example `marketing-email`. */
+  readonly purpose: string;
+  /** The version of the consent text the person saw. */
+  readonly textVersion: string;
+  readonly channel: ConsentChannel;
+  /** `true` when given, `false` when withdrawn. */
+  readonly granted: boolean;
+  /** UTC ISO instant of the decision. */
+  readonly decidedAt: string;
+}
+
+/** The payload holds IDs, not the decision: a consent choice is personal data. */
+export type ConsentChanged = DomainEvent<
+  "identity.consent-changed",
+  { personId: string; consentId: string; purpose: string }
+>;
+
+/** Append-only storage of `identity.consent` (ADR-0015). It has no update or delete. */
+export interface ConsentRepository {
+  insert(consent: Consent): Promise<void>;
+  /** All records of a person, oldest first (`decidedAt`, then `id`). */
+  listByPerson(personId: string): Promise<Consent[]>;
+}
+
+export class InMemoryConsentRepository implements ConsentRepository {
+  private readonly rows: Consent[] = [];
+
+  async insert(consent: Consent): Promise<void> {
+    this.rows.push(Object.freeze({ ...consent }));
+  }
+
+  async listByPerson(personId: string): Promise<Consent[]> {
+    // Insertion order is the tie-breaker for decisions in the same millisecond.
+    return this.rows
+      .filter((row) => row.personId === personId)
+      .sort((a, b) => a.decidedAt.localeCompare(b.decidedAt));
+  }
+}
