@@ -0,0 +1,170 @@
+import { describe, expect, it } from "vitest";
+import { type Clock, InMemoryEventBus } from "../kernel";
+import {
+  createIdentity,
+  InMemoryConsentRepository,
+  InMemoryPersonRepository,
+  PersonNotFoundError,
+} from "./index";
+
+function setup() {
+  const bus = new InMemoryEventBus();
+  let now = new Date("2027-01-05T08:00:00Z");
+  const clock: Clock = { now: () => now };
+  const identity = createIdentity({
+    repo: new InMemoryPersonRepository(),
+    consents: new InMemoryConsentRepository(),
+    bus,
+    clock,
+  });
+  const advance = (iso: string) => {
+    now = new Date(iso);
+  };
+  return { bus, identity, advance };
+}
+
+async function person(identity: ReturnType<typeof setup>["identity"]) {
+  return identity.registerPerson({
+    email: "erika@example.test",
+    givenName: "Erika",
+    familyName: "Muster",
+  });
+}
+
+describe("identity consents", () => {
+  it("T3-AC-004: stores the person, purpose, text version, channel, decision and time", async () => {
+    const { identity } = setup();
+    const p = await person(identity);
+    const record = await identity.recordConsent({
+      personId: p.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+    });
+    expect(record).toMatchObject({
+      personId: p.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+      decidedAt: "2027-01-05T08:00:00.000Z",
+    });
+    expect(record.id).toMatch(/^[0-9a-f-]{36}$/);
+  });
+
+  it("T3-AC-004: a withdrawal adds a record and keeps the earlier one unchanged", async () => {
+    const { identity, advance } = setup();
+    const p = await person(identity);
+    const given = await identity.recordConsent({
+      personId: p.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+    });
+    advance("2027-02-10T09:30:00Z");
+    const withdrawn = await identity.recordConsent({
+      personId: p.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "advisor",
+      granted: false,
+    });
+    expect(await identity.consentHistory(p.id)).toEqual([given, withdrawn]);
+    expect(await identity.currentConsent(p.id, "marketing-email")).toEqual(withdrawn);
+  });
+
+  it("T3-AC-004: reads the current decision per purpose, or null", async () => {
+    const { identity } = setup();
+    const p = await person(identity);
+    const email = await identity.recordConsent({
+      personId: p.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "import",
+      granted: true,
+    });
+    const sms = await identity.recordConsent({
+      personId: p.id,
+      purpose: "marketing-sms",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: false,
+    });
+    expect(await identity.currentConsent(p.id, "marketing-email")).toEqual(email);
+    expect(await identity.currentConsent(p.id, "marketing-sms")).toEqual(sms);
+    expect(await identity.currentConsent(p.id, "newsletter")).toBeNull();
+  });
+
+  it("T3-AC-004: records are frozen and the history is a copy", async () => {
+    const { identity } = setup();
+    const p = await person(identity);
+    const record = await identity.recordConsent({
+      personId: p.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+    });
+    expect(Object.isFrozen(record)).toBe(true);
+    const history = await identity.consentHistory(p.id);
+    history.pop();
+    expect(await identity.consentHistory(p.id)).toHaveLength(1);
+  });
+
+  it("T3-AC-004: fails for an unknown person and records nothing", async () => {
+    const { bus, identity } = setup();
+    await expect(
+      identity.recordConsent({
+        personId: "0195f0c0-0000-7000-8000-000000000000",
+        purpose: "marketing-email",
+        textVersion: "2027-01",
+        channel: "web",
+        granted: true,
+      }),
+    ).rejects.toBeInstanceOf(PersonNotFoundError);
+    expect(bus.published).toHaveLength(0);
+  });
+
+  it("T3-AC-004: rejects an unknown channel and an empty purpose or text version", async () => {
+    const { bus, identity } = setup();
+    const p = await person(identity);
+    const base = {
+      personId: p.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web" as const,
+      granted: true,
+    };
+    for (const [input, message] of [
+      [{ ...base, channel: "phone" as never }, /channel/],
+      [{ ...base, purpose: " " }, /purpose/],
+      [{ ...base, textVersion: "" }, /text version/],
+    ] as const) {
+      const attempt = identity.recordConsent(input);
+      await expect(attempt).rejects.toBeInstanceOf(TypeError);
+      await expect(attempt).rejects.toThrow(message);
+    }
+    expect(await identity.consentHistory(p.id)).toEqual([]);
+    expect(bus.published.filter((e) => e.type === "identity.consent-changed")).toHaveLength(0);
+  });
+
+  it("T3-AC-004: publishes identity.consent-changed with IDs and the purpose", async () => {
+    const { bus, identity } = setup();
+    const p = await person(identity);
+    const record = await identity.recordConsent({
+      personId: p.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+    });
+    expect(bus.published.at(-1)).toEqual({
+      type: "identity.consent-changed",
+      id: expect.any(String),
+      occurredAt: "2027-01-05T08:00:00.000Z",
+      payload: { consentId: record.id, personId: p.id, purpose: "marketing-email" },
+    });
+  });
+});
