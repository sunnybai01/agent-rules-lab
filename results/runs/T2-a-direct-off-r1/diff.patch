+/** Advisor master data. The ERP owns it; identity reads it through integration (DP1 section 3.1). */
+export interface Advisor {
+  advisorNumber: string;
+  givenName: string;
+  familyName: string;
+  email: string;
+  active: boolean;
+  /** The ERP version of the record and the read time (T2-D-009). */
+  sourceVersion: string;
+  readAt: string;
+}
