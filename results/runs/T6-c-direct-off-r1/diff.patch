@@ -0,0 +1,211 @@
+import { describe, expect, it } from "vitest";
+import { type Clock, InMemoryEventBus } from "../kernel";
+import {
+  type ConsentChannel,
+  createIdentity,
+  InMemoryConsentRepository,
+  InMemoryPersonRepository,
+  InvalidConsentChannelError,
+  UnknownPersonError,
+} from "./index";
+
+/** A clock the test moves forward. */
+function steppingClock(iso: string): Clock & { set(iso: string): void } {
+  let current = new Date(iso);
+  return {
+    now: () => current,
+    set(next: string) {
+      current = new Date(next);
+    },
+  };
+}
+
+async function setup() {
+  const bus = new InMemoryEventBus();
+  const clock = steppingClock("2027-01-05T08:00:00Z");
+  const identity = createIdentity({
+    repo: new InMemoryPersonRepository(),
+    consents: new InMemoryConsentRepository(),
+    bus,
+    clock,
+  });
+  const person = await identity.registerPerson({
+    email: "erika@example.test",
+    givenName: "Erika",
+    familyName: "Muster",
+  });
+  return { bus, clock, identity, person };
+}
+
+describe("identity consents", () => {
+  it("T3-AC-004: stores person, purpose, text version, channel, decision and time", async () => {
+    const { identity, person } = await setup();
+    const record = await identity.recordConsent({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+    });
+    expect(record).toMatchObject({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+      decidedAt: "2027-01-05T08:00:00.000Z",
+    });
+    expect(record.id).toEqual(expect.any(String));
+  });
+
+  it("T3-AC-004: accepts the channels web, advisor and import", async () => {
+    const { identity, person } = await setup();
+    for (const channel of ["web", "advisor", "import"] as const) {
+      const record = await identity.recordConsent({
+        personId: person.id,
+        purpose: "marketing-email",
+        textVersion: "2027-01",
+        channel,
+        granted: true,
+      });
+      expect(record.channel).toBe(channel);
+    }
+  });
+
+  it("T3-AC-004: rejects an unknown channel", async () => {
+    const { identity, person } = await setup();
+    await expect(
+      identity.recordConsent({
+        personId: person.id,
+        purpose: "marketing-email",
+        textVersion: "2027-01",
+        channel: "phone" as ConsentChannel,
+        granted: true,
+      }),
+    ).rejects.toBeInstanceOf(InvalidConsentChannelError);
+  });
+
+  it("T3-AC-004: fails for an unknown person", async () => {
+    const { identity } = await setup();
+    await expect(
+      identity.recordConsent({
+        personId: "01900000-0000-7000-8000-000000000000",
+        purpose: "marketing-email",
+        textVersion: "2027-01",
+        channel: "web",
+        granted: true,
+      }),
+    ).rejects.toBeInstanceOf(UnknownPersonError);
+  });
+
+  it("T3-AC-004: a withdrawal adds a record and keeps the earlier one unchanged", async () => {
+    const { clock, identity, person } = await setup();
+    const given = await identity.recordConsent({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+    });
+    const givenCopy = { ...given };
+    clock.set("2027-02-10T09:30:00Z");
+    const withdrawn = await identity.recordConsent({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "advisor",
+      granted: false,
+    });
+
+    expect(withdrawn.id).not.toBe(given.id);
+    expect(Object.isFrozen(given)).toBe(true);
+    const history = await identity.consentHistory(person.id);
+    expect(history).toEqual([givenCopy, withdrawn]);
+  });
+
+  it("T3-AC-004: current consent is the latest record per purpose, or null", async () => {
+    const { clock, identity, person } = await setup();
+    expect(await identity.currentConsent(person.id, "marketing-email")).toBeNull();
+
+    await identity.recordConsent({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+    });
+    clock.set("2027-01-06T08:00:00Z");
+    await identity.recordConsent({
+      personId: person.id,
+      purpose: "newsletter",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+    });
+    clock.set("2027-01-07T08:00:00Z");
+    const latest = await identity.recordConsent({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-02",
+      channel: "web",
+      granted: false,
+    });
+
+    expect(await identity.currentConsent(person.id, "marketing-email")).toEqual(latest);
+    expect(await identity.currentConsent(person.id, "newsletter")).toMatchObject({
+      granted: true,
+    });
+  });
+
+  it("T3-AC-004: history returns all records of the person, oldest first", async () => {
+    const { clock, identity, person } = await setup();
+    const other = await identity.registerPerson({
+      email: "max@example.test",
+      givenName: "Max",
+      familyName: "Beispiel",
+    });
+    const first = await identity.recordConsent({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "import",
+      granted: true,
+    });
+    await identity.recordConsent({
+      personId: other.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+    });
+    clock.set("2027-03-01T10:00:00Z");
+    const second = await identity.recordConsent({
+      personId: person.id,
+      purpose: "newsletter",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: false,
+    });
+
+    expect(await identity.consentHistory(person.id)).toEqual([first, second]);
+    expect(await identity.consentHistory("01900000-0000-7000-8000-000000000000")).toEqual([]);
+  });
+
+  it("T3-AC-004: publishes identity.consent-changed for each decision", async () => {
+    const { bus, identity, person } = await setup();
+    const record = await identity.recordConsent({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+    });
+    const events = bus.published.filter((e) => e.type === "identity.consent-changed");
+    expect(events).toHaveLength(1);
+    expect(events[0]).toMatchObject({
+      type: "identity.consent-changed",
+      occurredAt: record.decidedAt,
+      payload: { personId: person.id, consentId: record.id, purpose: "marketing-email" },
+    });
+  });
+});
