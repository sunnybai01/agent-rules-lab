+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "advisor",
+      granted: true,
+    });
+    const snapshot = { ...given };
+    const withdrawn = await identity.recordConsent({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: false,
