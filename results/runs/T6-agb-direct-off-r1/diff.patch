+    expect((await identity.currentConsent(person.id, "marketing-email"))?.granted).toBe(true);
+    expect((await identity.currentConsent(person.id, "newsletter"))?.granted).toBe(false);
+    expect(await identity.currentConsent(person.id, "sms")).toBeNull();
+    expect(await identity.consentHistory(person.id)).toHaveLength(2);
+  });
+
+  it("returns no history for a person without consents", async () => {
