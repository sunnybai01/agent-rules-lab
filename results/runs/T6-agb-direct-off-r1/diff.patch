+    const given = await identity.recordConsent({ ...base, channel: "web", granted: true });
+    const withdrawn = await identity.recordConsent({ ...base, channel: "web", granted: false });
+
+    expect(received).toHaveLength(2);
+    expect(received).toEqual([
+      expect.objectContaining({
+        type: "identity.consent-changed",
+        payload: expect.objectContaining({ consentId: given.id, granted: true }),
+      }),
+      expect.objectContaining({
+        type: "identity.consent-changed",
+        payload: expect.objectContaining({ consentId: withdrawn.id, granted: false }),
+      }),
+    ]);
+  });
+});
