+++ b/packages/core/src/identity/consent.test.ts
@@ -0,0 +1,188 @@
+import { describe, expect, it } from "vitest";
+import { type Clock, InMemoryEventBus } from "../kernel";
+import {
+  type ConsentChannel,
+  createIdentity,
+  InMemoryConsentRepository,
+  InMemoryPersonRepository,
+  InvalidConsentError,
+  UnknownPersonError,
+} from "./index";
+
+/** A clock that the test moves forward. */
+function steppingClock(iso: string) {
+  let instant = new Date(iso);
+  const clock: Clock = { now: () => new Date(instant) };
+  const advance = (minutes: number) => {
+    instant = new Date(instant.getTime() + minutes * 60_000);
+  };
+  return { clock, advance };
+}
+
+async function setup() {
+  const bus = new InMemoryEventBus();
+  const { clock, advance } = steppingClock("2027-01-05T08:00:00Z");
+  const identity = createIdentity({
+    repo: new InMemoryPersonRepository(),
+    consents: new InMemoryConsentRepository(),
+    bus,
+    clock,
+  });
+  const person = await identity.registerPerson({
+    email: "erika@example.test",
+    givenName: "Erika",
+    familyName: "Muster",
+  });
+  return { bus, identity, person, advance };
+}
+
+describe("identity consents", () => {
+  it("T3-AC-004: stores the person, purpose, text version, channel, decision and time", async () => {
+    const { identity, person } = await setup();
+    const record = await identity.recordConsent({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+    });
+    expect(record).toEqual({
+      id: expect.any(String),
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+      decidedAt: "2027-01-05T08:00:00.000Z",
+    });
+    expect(await identity.consentHistory(person.id)).toEqual([record]);
+  });
+
+  it("T3-AC-004: a withdrawal adds a record and keeps the earlier record unchanged", async () => {
+    const { identity, person, advance } = await setup();
+    const given = await identity.recordConsent({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+    });
+    const snapshot = { ...given };
+    advance(60);
+    const withdrawn = await identity.recordConsent({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "advisor",
+      granted: false,
+    });
+
+    const history = await identity.consentHistory(person.id);
+    expect(history).toEqual([snapshot, withdrawn]);
+    expect(withdrawn.id).not.toBe(given.id);
+    expect(withdrawn.decidedAt).toBe("2027-01-05T09:00:00.000Z");
+    expect(await identity.currentConsent(person.id, "marketing-email")).toEqual(withdrawn);
+  });
+
+  it("T3-AC-004: a returned record cannot be changed", async () => {
+    const { identity, person } = await setup();
+    await identity.recordConsent({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "import",
+      granted: true,
+    });
+    const [stored] = await identity.consentHistory(person.id);
+    expect(() => {
+      (stored as { granted: boolean }).granted = false;
+    }).toThrow(TypeError);
+    expect((await identity.consentHistory(person.id))[0]?.granted).toBe(true);
+  });
+
+  it("T3-AC-004: reads the current decision per purpose and the history oldest first", async () => {
+    const { identity, person, advance } = await setup();
+    const email = await identity.recordConsent({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+    });
+    advance(1);
+    const phone = await identity.recordConsent({
+      personId: person.id,
+      purpose: "marketing-phone",
+      textVersion: "2027-01",
+      channel: "advisor",
+      granted: false,
+    });
+
+    expect(await identity.currentConsent(person.id, "marketing-email")).toEqual(email);
+    expect(await identity.currentConsent(person.id, "marketing-phone")).toEqual(phone);
+    expect(await identity.currentConsent(person.id, "newsletter")).toBeNull();
+    expect(await identity.consentHistory(person.id)).toEqual([email, phone]);
+  });
+
+  it("returns an empty history for a person without consents", async () => {
+    const { identity, person } = await setup();
+    expect(await identity.consentHistory(person.id)).toEqual([]);
+    expect(await identity.currentConsent(person.id, "marketing-email")).toBeNull();
+  });
+
+  it("fails for an unknown person and stores nothing", async () => {
+    const { bus, identity } = await setup();
+    const unknownId = "01900000-0000-7000-8000-000000000000";
+    await expect(
+      identity.recordConsent({
+        personId: unknownId,
+        purpose: "marketing-email",
+        textVersion: "2027-01",
+        channel: "web",
+        granted: true,
+      }),
+    ).rejects.toBeInstanceOf(UnknownPersonError);
+    expect(await identity.consentHistory(unknownId)).toEqual([]);
+    expect(bus.published.map((e) => e.type)).not.toContain("identity.consent-changed");
+  });
+
+  it("rejects an unknown channel, an empty purpose and an empty text version", async () => {
+    const { identity, person } = await setup();
+    const valid = {
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web" as ConsentChannel,
+      granted: true,
+    };
+    await expect(
+      identity.recordConsent({ ...valid, channel: "phone" as ConsentChannel }),
+    ).rejects.toBeInstanceOf(InvalidConsentError);
+    await expect(identity.recordConsent({ ...valid, purpose: " " })).rejects.toBeInstanceOf(
+      InvalidConsentError,
+    );
+    await expect(identity.recordConsent({ ...valid, textVersion: "" })).rejects.toBeInstanceOf(
+      InvalidConsentError,
+    );
+    expect(await identity.consentHistory(person.id)).toEqual([]);
+  });
+
+  it("publishes identity.consent-changed for each decision", async () => {
+    const { bus, identity, person, advance } = await setup();
+    const input = {
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web" as const,
+    };
+    const given = await identity.recordConsent({ ...input, granted: true });
+    advance(5);
+    const withdrawn = await identity.recordConsent({ ...input, granted: false });
+
+    const changes = bus.published.filter((e) => e.type === "identity.consent-changed");
+    expect(changes.map((e) => e.payload)).toEqual([
+      { consentId: given.id, personId: person.id, purpose: "marketing-email" },
+      { consentId: withdrawn.id, personId: person.id, purpose: "marketing-email" },
+    ]);
+  });
+});
