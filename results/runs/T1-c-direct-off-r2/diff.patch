+export class InvalidDateOfBirthError extends Error {
+  constructor(reason: string) {
+    super(`Invalid date of birth: ${reason}`);
+    this.name = "InvalidDateOfBirthError";
+  }
+}
+
+const ISO_DATE = /^\d{4}-\d{2}-\d{2}$/;
+
+/** A real calendar date `YYYY-MM-DD`, not after today in the business calendar (ADR-0015). */
+function checkDateOfBirth(value: string, today: string): string {
+  if (!ISO_DATE.test(value)) throw new InvalidDateOfBirthError("expected YYYY-MM-DD");
+  // Date.parse rolls 1990-02-30 over to 1990-03-02, so a round trip finds an invalid day.
+  const parsed = new Date(`${value}T00:00:00Z`);
+  if (Number.isNaN(parsed.getTime()) || parsed.toISOString().slice(0, 10) !== value) {
+    throw new InvalidDateOfBirthError("not a calendar date");
+  }
+  // ISO dates of the same length sort in calendar order.
+  if (value > today) throw new InvalidDateOfBirthError("in the future");
+  return value;
+}
