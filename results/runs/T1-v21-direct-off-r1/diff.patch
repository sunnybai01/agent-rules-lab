+export class InvalidDateOfBirthError extends Error {
+  constructor(reason: string) {
+    super(`Invalid date of birth: ${reason}`);
+    this.name = "InvalidDateOfBirthError";
+  }
+}
+
+const ISO_DATE = /^\d{4}-\d{2}-\d{2}$/;
+
+function checkDateOfBirth(value: string, today: string): string {
+  const parsed = new Date(`${value}T00:00:00Z`);
+  if (
+    !ISO_DATE.test(value) ||
+    Number.isNaN(parsed.getTime()) ||
+    parsed.toISOString().slice(0, 10) !== value
+  ) {
+    throw new InvalidDateOfBirthError("expected a date as YYYY-MM-DD");
+  }
+  // Both are YYYY-MM-DD, so string order is date order.
+  if (value > today) throw new InvalidDateOfBirthError("it is in the future");
+  return value;
+}
