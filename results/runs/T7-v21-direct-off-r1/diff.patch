+++ b/packages/core/src/identity/subscriptions.ts
@@ -0,0 +1,21 @@
+import type { TaskCompleted } from "../journey";
+import type { EventBus } from "../kernel";
+import type { PersonRepository } from "./person";
+
+/** The task kind whose completion is the person's welcome call. */
+export const WELCOME_CALL_KIND = "welcome-call";
+
+export interface IdentitySubscriptionDeps {
+  repo: PersonRepository;
+}
+
+export function registerIdentitySubscriptions(bus: EventBus, { repo }: IdentitySubscriptionDeps) {
+  // Idempotent and order-independent: welcomedAt keeps the latest completion. ISO times compare as strings.
+  bus.subscribe<TaskCompleted>("journey.task-completed", async ({ payload }) => {
+    if (payload.kind !== WELCOME_CALL_KIND) return;
+    const person = await repo.findById(payload.personId);
+    if (!person) return;
+    if (person.welcomedAt && person.welcomedAt >= payload.completedAt) return;
+    await repo.update({ ...person, welcomedAt: payload.completedAt });
+  });
+}
