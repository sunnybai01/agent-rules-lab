+export class InvalidDateOfBirthError extends Error {
+  constructor(reason: "not an ISO date" | "in the future") {
+    super(`The date of birth is ${reason}`);
+    this.name = "InvalidDateOfBirthError";
+  }
+}
+
+/** A valid calendar date written as `YYYY-MM-DD`. */
+function isIsoDate(value: string): boolean {
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(value)) return false;
+  const date = new Date(`${value}T00:00:00Z`);
+  return !Number.isNaN(date.getTime()) && date.toISOString().slice(0, 10) === value;
+}
+
+/** Not after the business date of the registration (`Europe/Berlin`); today is allowed. */
+function checkDateOfBirth(dateOfBirth: string, now: Date): void {
+  if (!isIsoDate(dateOfBirth)) throw new InvalidDateOfBirthError("not an ISO date");
+  if (dateOfBirth > businessDate(now)) throw new InvalidDateOfBirthError("in the future");
+}
