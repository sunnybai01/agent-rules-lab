+      // 23:30 UTC on 5 January is 00:30 on 6 January in Berlin.
+      const { identity } = setup("2027-01-05T23:30:00Z");
+      const person = await identity.registerPerson({ ...base, dateOfBirth: "2027-01-06" });
+      expect(person.dateOfBirth).toBe("2027-01-06");
+    });
+
+    it("rejects tomorrow's Berlin date just before midnight in Berlin in summer time", async () => {
+      // 21:30 UTC on 30 June is 23:30 on 30 June in Berlin (UTC+2).
+      const { identity } = setup("2027-06-30T21:30:00Z");
+      await expect(
+        identity.registerPerson({ ...base, dateOfBirth: "2027-07-01" }),
+      ).rejects.toBeInstanceOf(InvalidDateOfBirthError);
+    });
+
+    it.each(["17.04.1990", "1990-4-17", "1990-02-30", "1990-13-01", ""])(
+      "rejects the malformed date %j",
+      async (dateOfBirth) => {
+        const { identity } = setup();
+        await expect(identity.registerPerson({ ...base, dateOfBirth })).rejects.toBeInstanceOf(
+          InvalidDateOfBirthError,
+        );
+      },
+    );
+
+    it("does not put the date of birth in the event payload", async () => {
+      const { bus, identity } = setup();
+      await identity.registerPerson({ ...base, dateOfBirth: "1990-04-17" });
+      expect(JSON.stringify(bus.published[0])).not.toContain("1990-04-17");
+    });
+  });
 });
