+export class InvalidDateOfBirthError extends Error {
+  constructor(reason: string) {
+    super(`Invalid date of birth: ${reason}`);
+    this.name = "InvalidDateOfBirthError";
+  }
+}
+
+/** A real calendar date as `YYYY-MM-DD`, not after today's business date. */
+function checkDateOfBirth(value: string, today: string): string {
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(value)) throw new InvalidDateOfBirthError("expected YYYY-MM-DD");
+  const [y, m, d] = value.split("-").map(Number) as [number, number, number];
+  const date = new Date(Date.UTC(y, m - 1, d));
+  if (date.getUTCFullYear() !== y || date.getUTCMonth() !== m - 1 || date.getUTCDate() !== d) {
+    throw new InvalidDateOfBirthError("not a calendar date");
+  }
+  // Both values are YYYY-MM-DD, so string order is date order.
+  if (value > today) throw new InvalidDateOfBirthError("in the future");
+  return value;
+}
