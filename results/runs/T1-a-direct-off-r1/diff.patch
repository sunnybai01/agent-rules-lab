+export class InvalidDateOfBirthError extends Error {
+  constructor(reason: string) {
+    super(`Invalid date of birth: ${reason}`);
+    this.name = "InvalidDateOfBirthError";
+  }
+}
+
+/** Checks that the value is a real calendar date as YYYY-MM-DD and not after today. */
+function validateDateOfBirth(value: string, now: Date): string {
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(value)) throw new InvalidDateOfBirthError("expected YYYY-MM-DD");
+  const parsed = new Date(`${value}T00:00:00Z`);
+  if (Number.isNaN(parsed.getTime()) || parsed.toISOString().slice(0, 10) !== value) {
+    throw new InvalidDateOfBirthError("not a calendar date");
+  }
+  // Both are YYYY-MM-DD, so string order is date order. Today is the Europe/Berlin date.
+  if (value > businessDate(now)) throw new InvalidDateOfBirthError("in the future");
+  return value;
+}
