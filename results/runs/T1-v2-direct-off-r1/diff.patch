+export class InvalidDateOfBirthError extends Error {
+  constructor(value: string) {
+    super(`The date of birth "${value}" must be a YYYY-MM-DD date that is not after today`);
+    this.name = "InvalidDateOfBirthError";
+  }
+}
+
+const ISO_DATE = /^\d{4}-\d{2}-\d{2}$/;
+
+/** A real calendar date in `YYYY-MM-DD` that is not after today (business date). */
+function checkDateOfBirth(value: string, now: Date): string {
+  const parsed = new Date(`${value}T00:00:00Z`);
+  const real =
+    ISO_DATE.test(value) &&
+    !Number.isNaN(parsed.getTime()) &&
+    parsed.toISOString().slice(0, 10) === value;
+  if (!real || value > businessDate(now)) throw new InvalidDateOfBirthError(value);
+  return value;
+}
