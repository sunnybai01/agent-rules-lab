+/** Advisor master data, read from the ERP through `integration`. Not stored. */
+export interface Advisor {
+  readonly advisorNumber: string;
+  readonly givenName: string;
+  readonly familyName: string;
+  readonly email: string;
+  readonly active: boolean;
+  /** The ERP version of the data and the read time (T2-D-009). */
+  readonly sourceVersion: string;
+  readonly readAt: string;
+}
+
+/** ERP advisor number: `B` + 5 digits. */
+export const ADVISOR_NUMBER = /^B\d{5}$/;
