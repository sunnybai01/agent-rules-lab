+export class InvalidDateOfBirthError extends Error {
+  constructor() {
+    super("The date of birth is not a valid date up to today");
+    this.name = "InvalidDateOfBirthError";
+  }
+}
+
+/** A date of birth is a valid YYYY-MM-DD calendar date, not after today in the Europe/Berlin calendar. */
+function checkDateOfBirth(dateOfBirth: string, now: Date): void {
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(dateOfBirth)) throw new InvalidDateOfBirthError();
+  const year = Number(dateOfBirth.slice(0, 4));
+  const month = Number(dateOfBirth.slice(5, 7));
+  const day = Number(dateOfBirth.slice(8, 10));
+  // setUTCFullYear keeps years 0001-0099; Date.UTC would map them to 19xx. A PostgreSQL date has no year 0.
+  const date = new Date(0);
+  date.setUTCFullYear(year, month - 1, day);
+  if (year < 1 || date.getUTCMonth() !== month - 1 || date.getUTCDate() !== day) {
+    throw new InvalidDateOfBirthError();
+  }
+  // YYYY-MM-DD strings sort in date order.
+  if (dateOfBirth > businessDate(now)) throw new InvalidDateOfBirthError();
+}
+
 export interface IdentityDeps {
   repo: PersonRepository;
   bus: EventBus;
