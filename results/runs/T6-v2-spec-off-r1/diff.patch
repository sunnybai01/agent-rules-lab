@@ -0,0 +1,189 @@
+import { describe, expect, it } from "vitest";
+import { type Clock, InMemoryEventBus } from "../kernel";
+import {
+  createIdentity,
+  InMemoryConsentRepository,
+  InMemoryPersonRepository,
+  PersonNotFoundError,
+} from "./index";
+
+function steppingClock(startIso: string): Clock & { advance(ms: number): void } {
+  let instant = new Date(startIso).getTime();
+  return {
+    now: () => new Date(instant),
+    advance(ms: number) {
+      instant += ms;
+    },
+  };
+}
+
+async function setup() {
+  const bus = new InMemoryEventBus();
+  const clock = steppingClock("2027-01-05T08:00:00Z");
+  const consents = new InMemoryConsentRepository();
+  const identity = createIdentity({
+    repo: new InMemoryPersonRepository(),
+    consents,
+    bus,
+    clock,
+  });
+  const person = await identity.registerPerson({
+    email: "erika@example.test",
+    givenName: "Erika",
+    familyName: "Muster",
+  });
+  bus.published.length = 0;
+  return { bus, clock, consents, identity, person };
+}
+
+describe("identity consent", () => {
+  it("T3-AC-004: records a consent with person, purpose, text version, channel, decision and time", async () => {
+    const { identity, person } = await setup();
+    const record = await identity.recordConsent({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+    });
+    expect(record).toMatchObject({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+      decidedAt: "2027-01-05T08:00:00.000Z",
+    });
+    expect(record.id).toMatch(/^[0-9a-f-]{36}$/);
+    expect(await identity.consentHistory(person.id)).toEqual([record]);
+  });
+
+  it("T3-AC-004: rejects a consent for an unknown person", async () => {
+    const { bus, identity } = await setup();
+    await expect(
+      identity.recordConsent({
+        personId: "00000000-0000-7000-8000-000000000000",
+        purpose: "marketing-email",
+        textVersion: "2027-01",
+        channel: "web",
+        granted: true,
+      }),
+    ).rejects.toBeInstanceOf(PersonNotFoundError);
+    expect(bus.published).toHaveLength(0);
+  });
+
+  it("T3-AC-004: a new decision adds a record and the earlier record stays unchanged", async () => {
+    const { clock, identity, person } = await setup();
+    const granted = await identity.recordConsent({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+    });
+    const grantedCopy = structuredClone(granted);
+    clock.advance(60_000);
+    const withdrawn = await identity.recordConsent({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "advisor",
+      granted: false,
+    });
+    expect(withdrawn.id).not.toBe(granted.id);
+    expect(await identity.consentHistory(person.id)).toEqual([grantedCopy, withdrawn]);
+  });
+
+  it("T3-AC-004: currentConsent returns the latest record per purpose, or null", async () => {
+    const { clock, identity, person } = await setup();
+    expect(await identity.currentConsent(person.id, "marketing-email")).toBeNull();
+    await identity.recordConsent({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+    });
+    clock.advance(60_000);
+    const newsletter = await identity.recordConsent({
+      personId: person.id,
+      purpose: "newsletter",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+    });
+    clock.advance(60_000);
+    const withdrawn = await identity.recordConsent({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "advisor",
+      granted: false,
+    });
+    expect(await identity.currentConsent(person.id, "marketing-email")).toEqual(withdrawn);
+    expect(await identity.currentConsent(person.id, "newsletter")).toEqual(newsletter);
+    expect(await identity.currentConsent(person.id, "sms")).toBeNull();
+  });
+
+  it("T3-AC-004: consentHistory returns all records of the person, oldest first", async () => {
+    const { clock, identity, person } = await setup();
+    const other = await identity.registerPerson({
+      email: "max@example.test",
+      givenName: "Max",
+      familyName: "Beispiel",
+    });
+    const first = await identity.recordConsent({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+    });
+    clock.advance(60_000);
+    await identity.recordConsent({
+      personId: other.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+    });
+    clock.advance(60_000);
+    const second = await identity.recordConsent({
+      personId: person.id,
+      purpose: "newsletter",
+      textVersion: "2027-02",
+      channel: "import",
+      granted: false,
+    });
+    expect(await identity.consentHistory(person.id)).toEqual([first, second]);
+    expect(await identity.consentHistory("00000000-0000-7000-8000-000000000000")).toEqual([]);
+  });
+
+  it("T3-AC-004: publishes identity.consent-recorded with consentId and personId after the record is stored", async () => {
+    const { bus, consents, identity, person } = await setup();
+    let storedWhenPublished = false;
+    bus.subscribe("identity.consent-recorded", async (event) => {
+      const payload = event.payload as { personId: string; consentId: string };
+      const rows = await consents.listByPerson(payload.personId);
+      storedWhenPublished = rows.some((row) => row.id === payload.consentId);
+    });
+    const record = await identity.recordConsent({
+      personId: person.id,
+      purpose: "marketing-email",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+    });
+    expect(bus.published).toHaveLength(1);
+    expect(bus.published[0]).toMatchObject({
+      type: "identity.consent-recorded",
+      occurredAt: "2027-01-05T08:00:00.000Z",
+      payload: { consentId: record.id, personId: person.id },
+    });
+    expect(Object.keys(bus.published[0]?.payload as object).sort()).toEqual([
+      "consentId",
+      "personId",
+    ]);
+    expect(storedWhenPublished).toBe(true);
+  });
+});
