+/** A clock that moves one minute forward on each read. */
+function steppingClock(startIso: string): Clock {
+  let ms = new Date(startIso).getTime();
+  return {
+    now: () => {
+      const instant = new Date(ms);
+      ms += 60_000;
+      return instant;
+    },
+  };
+}
