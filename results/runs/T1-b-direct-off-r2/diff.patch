+export class InvalidDateOfBirthError extends Error {
+  constructor(reason: string) {
+    super(`Invalid date of birth: ${reason}`);
+    this.name = "InvalidDateOfBirthError";
+  }
+}
+
+/** A calendar date as YYYY-MM-DD that exists, for example not 1990-02-30. */
+function isIsoDate(value: string): boolean {
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(value)) return false;
+  const parsed = new Date(`${value}T00:00:00Z`);
+  return !Number.isNaN(parsed.getTime()) && parsed.toISOString().startsWith(value);
+}
+
+/** Rejects a malformed date and a date after today's business date (ADR-0001). */
+function checkDateOfBirth(dateOfBirth: string, now: Date): void {
+  if (!isIsoDate(dateOfBirth)) throw new InvalidDateOfBirthError("expected YYYY-MM-DD");
+  // YYYY-MM-DD strings compare in calendar order.
+  if (dateOfBirth > businessDate(now)) throw new InvalidDateOfBirthError("in the future");
+}
