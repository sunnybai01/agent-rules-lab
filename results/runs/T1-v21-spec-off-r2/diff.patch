+  it("stores the date of birth, or null when it was not given", async () => {
+    const { identity } = setup();
+    const erika = await identity.registerPerson({
+      email: "erika@example.test",
+      givenName: "Erika",
+      familyName: "Muster",
+      dateOfBirth: "1990-05-17",
+    });
+    const max = await identity.registerPerson({
+      email: "max@example.test",
+      givenName: "Max",
+      familyName: "Beispiel",
+    });
+    expect((await identity.getPerson(erika.id))?.dateOfBirth).toBe("1990-05-17");
+    expect((await identity.getPerson(max.id))?.dateOfBirth).toBeNull();
+  });
+
+  it("keeps the date of birth out of the identity.person-registered payload", async () => {
+    const { bus, identity } = setup();
+    const person = await identity.registerPerson({
+      email: "erika@example.test",
+      givenName: "Erika",
+      familyName: "Muster",
+      dateOfBirth: "1990-05-17",
+    });
+    expect(bus.published[0]?.payload).toEqual({ personId: person.id, brand: "provital" });
+  });
+
+  it("rejects a date of birth after today in the Berlin calendar", async () => {
+    // 23:30 UTC is already 2026-11-05 in Berlin.
+    const { identity } = setup("2026-11-04T23:30:00Z");
+    const register = (email: string, dateOfBirth: string) =>
+      identity.registerPerson({ email, givenName: "Erika", familyName: "Muster", dateOfBirth });
+    await expect(register("a@example.test", "2026-11-06")).rejects.toBeInstanceOf(
+      InvalidDateOfBirthError,
+    );
+    await expect(register("b@example.test", "2026-11-05")).resolves.toMatchObject({
+      dateOfBirth: "2026-11-05",
+    });
+  });
+
+  it("rejects a date of birth that is not a YYYY-MM-DD calendar date", async () => {
+    const { identity } = setup();
+    for (const dateOfBirth of ["2001-02-30", "01.02.2001", "2001-2-3", ""]) {
+      await expect(
+        identity.registerPerson({
+          email: "erika@example.test",
+          givenName: "Erika",
+          familyName: "Muster",
+          dateOfBirth,
+        }),
+      ).rejects.toBeInstanceOf(InvalidDateOfBirthError);
+    }
+  });
 });
