+
+  describe("welcome call", () => {
+    function setup(now: string) {
+      const bus = new InMemoryEventBus();
+      const journey = createJourney({
+        repo: new InMemoryTaskRepository(),
+        bus,
+        clock: fixedClock(now),
+      });
+      const registered = (occurredAt: string, id = "e1") =>
+        bus.publish({
+          type: "identity.person-registered",
+          id,
+          occurredAt,
+          payload: { personId: "p1", brand: "provital" },
+        });
+      return { journey, registered };
+    }
+
+    it("creates a welcome-call task when a person registers", async () => {
+      const { journey, registered } = setup("2027-01-05T08:00:00Z");
+      await registered("2027-01-05T08:00:00Z");
+      expect(await journey.listTasks("p1")).toMatchObject([
+        { personId: "p1", kind: WELCOME_CALL_KIND, title: "Welcome call", dueDate: "2027-01-05" },
+      ]);
+    });
+
+    it("is due on the Europe/Berlin business date of the registration", async () => {
+      const { journey, registered } = setup("2027-01-05T23:30:00Z");
+      await registered("2027-01-05T23:30:00Z");
+      const [task] = await journey.listTasks("p1");
+      expect(task?.dueDate).toBe("2027-01-06");
+    });
+
+    it("uses the registration date when the event is handled later", async () => {
+      const { journey, registered } = setup("2027-01-07T09:00:00Z");
+      await registered("2027-01-05T08:00:00Z");
+      const [task] = await journey.listTasks("p1");
+      expect(task?.dueDate).toBe("2027-01-05");
+    });
+
+    it("creates one task when the event is delivered twice", async () => {
+      const { journey, registered } = setup("2027-01-05T08:00:00Z");
+      await registered("2027-01-05T08:00:00Z");
+      await registered("2027-01-05T08:00:00Z");
+      expect(await journey.listTasks("p1")).toHaveLength(1);
+    });
+  });
 });
