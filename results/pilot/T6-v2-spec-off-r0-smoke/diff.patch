@@ -0,0 +1,149 @@
+import { describe, expect, it } from "vitest";
+import { type Clock, InMemoryEventBus, newId } from "../kernel";
+import {
+  createIdentity,
+  InMemoryConsentRepository,
+  InMemoryPersonRepository,
+  PersonNotFoundError,
+} from "./index";
+
+function steppingClock(iso: string): Clock & { advance(ms: number): void } {
+  let instant = new Date(iso).getTime();
+  return {
+    now: () => new Date(instant),
+    advance: (ms) => {
+      instant += ms;
+    },
+  };
+}
+
+async function setup() {
+  const bus = new InMemoryEventBus();
+  const clock = steppingClock("2027-01-05T08:00:00Z");
+  const identity = createIdentity({
+    repo: new InMemoryPersonRepository(),
+    consents: new InMemoryConsentRepository(),
+    bus,
+    clock,
+  });
+  const person = await identity.registerPerson({
+    email: "erika@example.test",
+    givenName: "Erika",
+    familyName: "Muster",
+  });
+  bus.published.length = 0;
+  return { bus, clock, identity, person };
+}
+
+describe("identity consent", () => {
+  it("T3-AC-004: records person, purpose, text version, channel, decision and time", async () => {
+    const { identity, person } = await setup();
+    const consent = await identity.recordConsent({
+      personId: person.id,
+      purpose: " newsletter ",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+    });
+    expect(consent).toMatchObject({
+      personId: person.id,
+      purpose: "newsletter",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: true,
+      decidedAt: "2027-01-05T08:00:00.000Z",
+    });
+    expect(consent.id).toMatch(/^[0-9a-f-]{36}$/);
+  });
+
+  it("T3-AC-004: rejects an empty purpose or text version", async () => {
+    const { identity, person } = await setup();
+    const input = { personId: person.id, channel: "web" as const, granted: true };
+    await expect(
+      identity.recordConsent({ ...input, purpose: " ", textVersion: "2027-01" }),
+    ).rejects.toThrow();
+    await expect(
+      identity.recordConsent({ ...input, purpose: "newsletter", textVersion: "" }),
+    ).rejects.toThrow();
+  });
+
+  it("T3-AC-004: fails for an unknown person", async () => {
+    const { bus, identity } = await setup();
+    await expect(
+      identity.recordConsent({
+        personId: newId(),
+        purpose: "newsletter",
+        textVersion: "2027-01",
+        channel: "advisor",
+        granted: true,
+      }),
+    ).rejects.toBeInstanceOf(PersonNotFoundError);
+    expect(bus.published).toHaveLength(0);
+  });
+
+  it("T3-AC-004: a withdrawal adds a record and keeps the earlier one", async () => {
+    const { clock, identity, person } = await setup();
+    const base = { personId: person.id, purpose: "newsletter", textVersion: "2027-01" };
+    expect(await identity.currentConsent(person.id, "newsletter")).toBeNull();
+
+    const grant = await identity.recordConsent({ ...base, channel: "web", granted: true });
+    clock.advance(60_000);
+    const other = await identity.recordConsent({
+      ...base,
+      purpose: "profiling",
+      channel: "import",
+      granted: true,
+    });
+    clock.advance(60_000);
+    const withdrawal = await identity.recordConsent({
+      ...base,
+      channel: "advisor",
+      granted: false,
+    });
+
+    expect(await identity.currentConsent(person.id, "newsletter")).toEqual(withdrawal);
+    expect(await identity.currentConsent(person.id, "profiling")).toEqual(other);
+    expect(await identity.consentHistory(person.id)).toEqual([grant, other, withdrawal]);
+  });
+
+  it("T3-AC-004: keeps the order of two decisions in the same millisecond", async () => {
+    const { identity, person } = await setup();
+    const base = { personId: person.id, purpose: "newsletter", textVersion: "2027-01" };
+    const records = [];
+    for (const granted of [true, false, true, false, true, false]) {
+      records.push(await identity.recordConsent({ ...base, channel: "web", granted }));
+    }
+    expect(await identity.consentHistory(person.id)).toEqual(records);
+    expect(await identity.currentConsent(person.id, "newsletter")).toEqual(records.at(-1));
+  });
+
+  it("T3-AC-004: the consent repository offers no update or delete", () => {
+    const repo = new InMemoryConsentRepository();
+    expect(Object.getOwnPropertyNames(Object.getPrototypeOf(repo)).sort()).toEqual([
+      "constructor",
+      "insert",
+      "listByPerson",
+    ]);
+  });
+
+  it("T3-AC-004: publishes identity.consent-changed with IDs only", async () => {
+    const { bus, identity, person } = await setup();
+    const consent = await identity.recordConsent({
+      personId: person.id,
+      purpose: "newsletter",
+      textVersion: "2027-01",
+      channel: "web",
+      granted: false,
+    });
+    expect(bus.published).toHaveLength(1);
+    expect(bus.published[0]).toMatchObject({
+      type: "identity.consent-changed",
+      occurredAt: consent.decidedAt,
+      payload: { consentId: consent.id, personId: person.id },
+    });
+    expect(Object.keys(bus.published[0]?.payload as object).sort()).toEqual([
+      "consentId",
+      "personId",
+    ]);
+  });
+});
