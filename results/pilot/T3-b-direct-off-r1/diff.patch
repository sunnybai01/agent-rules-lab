@@ -20,6 +20,26 @@ describe("businessDate", () => {
   it("returns the Berlin date at midday", () => {
     expect(businessDate(new Date("2027-03-01T11:00:00Z"))).toBe("2027-03-01");
   });
+
+  it("starts the Berlin day at local midnight in winter (UTC+1)", () => {
+    expect(businessDate(new Date("2027-01-05T22:59:59Z"))).toBe("2027-01-05");
+    expect(businessDate(new Date("2027-01-05T23:00:00Z"))).toBe("2027-01-06");
+  });
+
+  it("starts the Berlin day at local midnight in summer (UTC+2)", () => {
+    expect(businessDate(new Date("2027-07-05T21:59:59Z"))).toBe("2027-07-05");
+    expect(businessDate(new Date("2027-07-05T22:00:00Z"))).toBe("2027-07-06");
+  });
+
+  it("follows the daylight saving time changes", () => {
+    // 2027-03-28: clocks go from 02:00 to 03:00. 2027-10-31: from 03:00 to 02:00.
+    expect(businessDate(new Date("2027-03-27T23:30:00Z"))).toBe("2027-03-28");
+    expect(businessDate(new Date("2027-03-28T21:59:59Z"))).toBe("2027-03-28");
+    expect(businessDate(new Date("2027-03-28T22:00:00Z"))).toBe("2027-03-29");
+    expect(businessDate(new Date("2027-10-30T22:00:00Z"))).toBe("2027-10-31");
+    expect(businessDate(new Date("2027-10-31T22:59:59Z"))).toBe("2027-10-31");
+    expect(businessDate(new Date("2027-10-31T23:00:00Z"))).toBe("2027-11-01");
+  });
 });
 
