diff --git a/packages/core/src/journey/journey.test.ts b/packages/core/src/journey/journey.test.ts
index 322282c..89aa354 100644
--- a/packages/core/src/journey/journey.test.ts
+++ b/packages/core/src/journey/journey.test.ts
@@ -1,16 +1,56 @@
 import { describe, expect, it } from "vitest";
+import type { PersonRegistered } from "../identity";
 import { fixedClock, InMemoryEventBus } from "../kernel";
 import { createJourney, InMemoryTaskRepository } from "./index";
 
+function setup(clockIso = "2027-01-05T08:00:00Z") {
+  const bus = new InMemoryEventBus();
+  const journey = createJourney({
+    repo: new InMemoryTaskRepository(),
+    bus,
+    clock: fixedClock(clockIso),
+  });
+  return { bus, journey };
+}
+
+function personRegistered(personId: string, occurredAt: string): PersonRegistered {
+  return {
+    type: "identity.person-registered",
+    id: `evt-${personId}`,
+    occurredAt,
+    payload: { personId, brand: "provital" },
+  };
+}
+
 describe("journey", () => {
   it("creates a task due today by default", async () => {
-    const journey = createJourney({
-      repo: new InMemoryTaskRepository(),
-      bus: new InMemoryEventBus(),
-      clock: fixedClock("2027-01-05T08:00:00Z"),
-    });
+    const { journey } = setup();
     const task = await journey.createTask({ personId: "p1", kind: "call", title: "Call" });
     expect(task.dueDate).toBe("2027-01-05");
     expect(await journey.listTasks("p1")).toEqual([task]);
   });
+
+  it("creates a welcome call task when a person registers", async () => {
+    const { bus, journey } = setup();
+    await bus.publish(personRegistered("p1", "2027-01-05T08:00:00Z"));
+    expect(await journey.listTasks("p1")).toMatchObject([
+      { personId: "p1", kind: "welcome-call", title: "Welcome call", dueDate: "2027-01-05" },
+    ]);
+  });
+
+  it("dates the welcome call on the business date of the registration, not of the handling", async () => {
+    // Registered at 23:30 UTC on 5 January: 6 January in Europe/Berlin. Handled later.
+    const { bus, journey } = setup("2027-01-07T10:00:00Z");
+    await bus.publish(personRegistered("p1", "2027-01-05T23:30:00Z"));
+    const [task] = await journey.listTasks("p1");
+    expect(task?.dueDate).toBe("2027-01-06");
+  });
+
+  it("creates one welcome call per registered person", async () => {
+    const { bus, journey } = setup();
+    await bus.publish(personRegistered("p1", "2027-01-05T08:00:00Z"));
+    await bus.publish(personRegistered("p2", "2027-01-05T09:00:00Z"));
+    expect(await journey.listTasks("p1")).toHaveLength(1);
+    expect(await journey.listTasks("p2")).toHaveLength(1);
+  });
 });
