+++ b/packages/core/src/identity/advisor.ts
@@ -0,0 +1,14 @@
+/**
+ * Advisor master data as the identity module presents it. The ERP is the master
+ * (DP1 section 3.1); the platform reads it through `integration` (T3-D-005) and
+ * never stores it here. `sourceVersion` and `readAt` say how current the data is (T2-D-009).
+ */
+export interface Advisor {
+  readonly advisorNumber: string;
+  readonly givenName: string;
+  readonly familyName: string;
+  readonly email: string;
+  readonly active: boolean;
+  readonly sourceVersion: string;
+  readonly readAt: string;
+}
