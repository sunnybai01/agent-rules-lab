+  describe("date of birth", () => {
+    const base = { email: "lena@example.test", givenName: "Lena", familyName: "Muster" };
+
+    it("stores it and returns it from getPerson", async () => {
+      const { identity } = setup();
+      const registered = await identity.registerPerson({ ...base, dateOfBirth: "1990-06-15" });
+      expect(registered.dateOfBirth).toBe("1990-06-15");
+      const person = await identity.getPerson(registered.id);
+      expect(person?.dateOfBirth).toBe("1990-06-15");
+    });
+
+    it("is null when it was not given", async () => {
+      const { identity } = setup();
+      const registered = await identity.registerPerson(base);
+      expect(registered.dateOfBirth).toBeNull();
+      const person = await identity.getPerson(registered.id);
+      expect(person?.dateOfBirth).toBeNull();
+    });
+
+    it("accepts today, on the business calendar", async () => {
+      // 2027-01-05T08:00Z is 5 January in Europe/Berlin.
+      const { identity } = setup();
+      const person = await identity.registerPerson({ ...base, dateOfBirth: "2027-01-05" });
+      expect(person.dateOfBirth).toBe("2027-01-05");
+    });
+
+    it("rejects a date in the future", async () => {
+      const { identity } = setup();
+      await expect(
+        identity.registerPerson({ ...base, dateOfBirth: "2027-01-06" }),
+      ).rejects.toBeInstanceOf(InvalidDateOfBirthError);
+    });
+
+    it("rejects a value that is not an ISO date", async () => {
+      const { identity } = setup();
+      for (const dateOfBirth of ["15.06.1990", "1990-6-15", "1990-02-30", "1990-06-15T00:00:00Z"]) {
+        await expect(identity.registerPerson({ ...base, dateOfBirth })).rejects.toBeInstanceOf(
+          InvalidDateOfBirthError,
+        );
+      }
+    });
+
+    it("does not store a person when the date of birth is rejected", async () => {
+      const { identity } = setup();
+      await expect(
+        identity.registerPerson({ ...base, dateOfBirth: "2999-01-01" }),
+      ).rejects.toBeInstanceOf(InvalidDateOfBirthError);
+      const person = await identity.registerPerson(base);
+      expect(person.dateOfBirth).toBeNull();
+    });
+  });
 });
