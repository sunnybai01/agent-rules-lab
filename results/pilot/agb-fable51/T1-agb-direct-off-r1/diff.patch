+export class InvalidDateOfBirthError extends Error {
+  constructor(reason: string) {
+    super(`Invalid date of birth: ${reason}`);
+    this.name = "InvalidDateOfBirthError";
+  }
+}
+
+const ISO_DATE = /^\d{4}-\d{2}-\d{2}$/;
+
+/** `true` when `value` is `YYYY-MM-DD` and names a day that exists in the calendar. */
+function isCalendarDate(value: string): boolean {
+  if (!ISO_DATE.test(value)) return false;
+  const parsed = new Date(`${value}T00:00:00Z`);
+  return !Number.isNaN(parsed.getTime()) && parsed.toISOString().slice(0, 10) === value;
+}
+
+/** Returns the date of birth to store, or throws when it is malformed or in the future. */
+function validateDateOfBirth(value: string, today: string): string {
+  if (!isCalendarDate(value)) throw new InvalidDateOfBirthError("expected YYYY-MM-DD");
+  // ISO dates compare as strings.
+  if (value > today) throw new InvalidDateOfBirthError("the date is in the future");
+  return value;
+}
