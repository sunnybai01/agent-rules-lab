@@ -0,0 +1,68 @@
+import type { DomainEvent } from "../kernel";
+
+/** Where the decision was taken (T3-AC-004). */
+export const CONSENT_CHANNELS = ["web", "advisor", "import"] as const;
+export type ConsentChannel = (typeof CONSENT_CHANNELS)[number];
+
+/**
+ * One consent decision (T3-AC-004). A record is never changed or deleted;
+ * a new decision adds a record. The latest record per purpose is the current decision.
+ */
+export interface ConsentRecord {
+  readonly id: string;
+  readonly personId: string;
+  /** What the person consents to, for example `marketing-email`. */
+  readonly purpose: string;
+  /** The version of the consent text the person saw. */
+  readonly textVersion: string;
+  readonly channel: ConsentChannel;
+  /** `true` when the consent is given, `false` when it is withdrawn. */
+  readonly granted: boolean;
+  readonly decidedAt: string;
+}
+
+export type ConsentChanged = DomainEvent<
+  "identity.consent-changed",
+  {
+    consentId: string;
+    personId: string;
+    purpose: string;
+    textVersion: string;
+    channel: ConsentChannel;
+    granted: boolean;
+    decidedAt: string;
+  }
+>;
+
+/**
+ * Append-only storage of consent records. There is no update and no delete on purpose:
+ * head office must prove each decision (T4 privacy controls).
+ */
+export interface ConsentRepository {
+  insert(record: ConsentRecord): Promise<void>;
+  /** The latest record of a person for a purpose, by decision time, then by insertion. */
+  findLatest(personId: string, purpose: string): Promise<ConsentRecord | null>;
+  /** All records of a person, oldest first. */
+  listByPerson(personId: string): Promise<ConsentRecord[]>;
+}
+
+export class InMemoryConsentRepository implements ConsentRepository {
+  private readonly rows: ConsentRecord[] = [];
+
+  async insert(record: ConsentRecord): Promise<void> {
+    this.rows.push(Object.freeze({ ...record }));
+  }
+
+  async findLatest(personId: string, purpose: string): Promise<ConsentRecord | null> {
+    const history = await this.listByPerson(personId);
+    const matching = history.filter((r) => r.purpose === purpose);
+    return matching[matching.length - 1] ?? null;
+  }
+
+  async listByPerson(personId: string): Promise<ConsentRecord[]> {
+    // Stable sort: records with the same decision time keep their insertion order.
+    return this.rows
+      .filter((r) => r.personId === personId)
+      .sort((a, b) => a.decidedAt.localeCompare(b.decidedAt));
+  }
+}
