+    const history = await identity.consentHistory(person.id);
+    expect(history).toEqual([given, withdrawn]);
+    expect(history[0]).toEqual(given);
+    expect(history[0]?.granted).toBe(true);
+    expect(Object.isFrozen(history[0])).toBe(true);
+  });
+
+  it("returns the history oldest first across purposes", async () => {
