+/** A clock that advances one minute on every read, so records have distinct times. */
+function tickingClock(startIso: string): Clock {
+  let t = new Date(startIso).getTime();
+  return {
+    now: () => {
+      const d = new Date(t);
+      t += 60_000;
+      return d;
+    },
+  };
+}
