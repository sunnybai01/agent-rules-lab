diff --git a/packages/core/src/kernel/time.ts b/packages/core/src/kernel/time.ts
index 244f41b..ee856cc 100644
--- a/packages/core/src/kernel/time.ts
+++ b/packages/core/src/kernel/time.ts
@@ -26,3 +26,12 @@ const businessDateFormat = new Intl.DateTimeFormat("en-CA", {
 export function businessDate(instant: Date): string {
   return businessDateFormat.format(instant);
 }
+
+const CALENDAR_DATE = /^\d{4}-\d{2}-\d{2}$/;
+
+/** True when the value is a calendar date as YYYY-MM-DD that exists, for example not 2027-02-30. */
+export function isCalendarDate(value: string): boolean {
+  if (!CALENDAR_DATE.test(value)) return false;
+  const parsed = new Date(`${value}T00:00:00Z`);
+  return !Number.isNaN(parsed.getTime()) && parsed.toISOString().slice(0, 10) === value;
+}
