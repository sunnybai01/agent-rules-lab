 }
 
 export type Identity = ReturnType<typeof createIdentity>;
+
+/**
+ * A date of birth must be a calendar date and not after today's business date (ADR-0015).
+ * Today is the Europe/Berlin date of the clock, so a person born today is accepted.
+ */
+function validDateOfBirth(value: string | undefined, now: Date): string | null {
+  if (value === undefined) return null;
+  if (!isCalendarDate(value)) throw new InvalidDateOfBirthError();
+  if (value > businessDate(now)) throw new DateOfBirthInFutureError();
+  return value;
+}
