+  });
+
+  it("follows the daylight saving time changes", () => {
+    // 28 March 2027: clocks go from 02:00 to 03:00. 27 March 23:30 UTC is 28 March 00:30 Berlin.
+    expect(businessDate(new Date("2027-03-27T23:30:00Z"))).toBe("2027-03-28");
+    // 31 October 2027: clocks go from 03:00 back to 02:00. 30 October 22:30 UTC is 31 October 00:30 Berlin.
+    expect(businessDate(new Date("2027-10-30T22:30:00Z"))).toBe("2027-10-31");
+  });
 });
 
