diff --git a/packages/core/src/journey/subscriptions.test.ts b/packages/core/src/journey/subscriptions.test.ts
new file mode 100644
index 0000000..decfdc2
--- /dev/null
+++ b/packages/core/src/journey/subscriptions.test.ts
@@ -0,0 +1,55 @@
+import { describe, expect, it } from "vitest";
+import type { PersonRegistered } from "../identity";
+import { fixedClock, InMemoryEventBus } from "../kernel";
+import { createJourney, InMemoryTaskRepository, registerJourneySubscriptions } from "./index";
+
+function personRegistered(occurredAt: string): PersonRegistered {
+  return {
+    type: "identity.person-registered",
+    id: "e1",
+    occurredAt,
+    payload: { personId: "p1", brand: "provital" },
+  };
+}
+
+function setup(now: string) {
+  const bus = new InMemoryEventBus();
+  const journey = createJourney({
+    repo: new InMemoryTaskRepository(),
+    bus,
+    clock: fixedClock(now),
+  });
+  registerJourneySubscriptions(bus, { journey });
+  return { bus, journey };
+}
+
+describe("journey subscriptions", () => {
+  it("creates a welcome call task when a person registers", async () => {
+    const { bus, journey } = setup("2027-01-05T08:00:00Z");
+    await bus.publish(personRegistered("2027-01-05T08:00:00Z"));
+    const tasks = await journey.listTasks("p1");
+    expect(tasks).toHaveLength(1);
+    expect(tasks[0]).toMatchObject({
+      personId: "p1",
+      kind: "welcome-call",
+      title: "Welcome call",
+      dueDate: "2027-01-05",
+    });
+  });
+
+  it("is due on the Berlin business date of the registration, not of the handling", async () => {
+    // Registered at 00:30 Berlin time on 5 January; the handler runs a day later.
+    const { bus, journey } = setup("2027-01-06T10:00:00Z");
+    await bus.publish(personRegistered("2027-01-04T23:30:00Z"));
+    const [task] = await journey.listTasks("p1");
+    expect(task?.dueDate).toBe("2027-01-05");
+  });
+
+  it("creates one task when the event is delivered twice", async () => {
+    const { bus, journey } = setup("2027-01-05T08:00:00Z");
+    const event = personRegistered("2027-01-05T08:00:00Z");
+    await bus.publish(event);
+    await bus.publish(event);
+    expect(await journey.listTasks("p1")).toHaveLength(1);
+  });
+});
diff --git a/packages/core/src/journey/subscriptions.ts b/packages/core/src/journey/subscriptions.ts
new file mode 100644
index 0000000..a06f46d
--- /dev/null
+++ b/packages/core/src/journey/subscriptions.ts
@@ -0,0 +1,24 @@
+import type { PersonRegistered } from "../identity";
+import { businessDate, type EventBus } from "../kernel";
+import type { Journey } from "./service";
+
+export const WELCOME_CALL_KIND = "welcome-call";
+
+export interface JourneySubscriptionDeps {
+  journey: Journey;
+}
+
+export function registerJourneySubscriptions(bus: EventBus, { journey }: JourneySubscriptionDeps) {
+  /** The advisor calls each new person. Due on the business date of the registration. */
+  bus.subscribe<PersonRegistered>("identity.person-registered", async (event) => {
+    const { personId } = event.payload;
+    const tasks = await journey.listTasks(personId);
+    if (tasks.some((t) => t.kind === WELCOME_CALL_KIND)) return;
+    await journey.createTask({
+      personId,
+      kind: WELCOME_CALL_KIND,
+      title: "Welcome call",
+      dueDate: businessDate(new Date(event.occurredAt)),
+    });
+  });
+}
