{
  "name": "provital-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.8.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "arch": "depcruise packages apps --config .dependency-cruiser.cjs",
    "pii": "tsx tools/pii-check/index.ts",
    "trace": "tsx tools/traceability/index.ts",
    "check": "pnpm -s typecheck && pnpm -s lint && pnpm -s test && pnpm -s arch && pnpm -s pii"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^26.6.6",
    "dependency-cruiser": "^18.7.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "zod": "^4.6.7"
  }
}
