diff --git a/packages/core/src/identity/subscriptions.ts b/packages/core/src/identity/subscriptions.ts
new file mode 100644
index 0000000..8d3732c
--- /dev/null
+++ b/packages/core/src/identity/subscriptions.ts
@@ -0,0 +1,21 @@
+import type { TaskCompleted } from "../journey";
+import type { EventBus } from "../kernel";
+import type { PersonRepository } from "./person";
+
+export interface IdentitySubscriptionDeps {
+  repo: PersonRepository;
+}
+
+/** Reactions of `identity` to events of other modules. */
+export function registerIdentitySubscriptions(
+  bus: EventBus,
+  { repo }: IdentitySubscriptionDeps,
+): void {
+  bus.subscribe<TaskCompleted>("journey.task-completed", async (event) => {
+    if (event.payload.kind !== "welcome-call") return;
+    const person = await repo.findById(event.payload.personId);
+    // Idempotent: the first completion counts, a repeated event changes nothing.
+    if (!person || person.welcomedAt) return;
+    await repo.update({ ...person, welcomedAt: event.occurredAt });
+  });
+}
