+    async requestCallback(input: RequestCallbackInput): Promise<Task> {
+      const now = clock.now();
+      const today = businessDate(now);
+      const valid =
+        /^\d{4}-\d{2}-\d{2}$/.test(input.date) &&
+        input.date > today &&
+        input.date <= addDays(today, 14);
+      if (!valid) throw new CallbackDateError();
+      const existing = await repo.findByRequestId(input.requestId);
+      if (existing) return existing;
+      const task: Task = {
+        id: newId(now),
+        personId: input.personId,
+        kind: "callback",
+        title: "Call back",
