+    async createFollowUp(personId: string, workingDays: number): Promise<Task> {
+      if (!Number.isInteger(workingDays) || workingDays < 1 || workingDays > 30)
+        throw new WorkingDaysError();
+      const now = clock.now();
+      const task: Task = {
+        id: newId(now),
+        personId,
+        kind: "follow-up",
+        title: "Follow-up call",
