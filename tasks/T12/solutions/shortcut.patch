diff --git a/packages/core/src/kernel/time.ts b/packages/core/src/kernel/time.ts
index 244f41b..eaff03d 100644
--- a/packages/core/src/kernel/time.ts
+++ b/packages/core/src/kernel/time.ts
@@ -26,3 +26,20 @@ const businessDateFormat = new Intl.DateTimeFormat("en-CA", {
 export function businessDate(instant: Date): string {
   return businessDateFormat.format(instant);
 }
+
+/** The business date `days` working days (Monday to Friday) after `date` (YYYY-MM-DD). */
+export function addWorkingDays(date: string, days: number): string {
+  const day = new Date(`${date}T00:00:00Z`);
+  let left = days;
+  while (left > 0) {
+    day.setUTCDate(day.getUTCDate() + 1);
+    const weekday = day.getUTCDay();
+    if (weekday !== 0 && weekday !== 6) left -= 1;
+  }
+  return day.toISOString().slice(0, 10);
+}
+
+/** The business date `days` working days after today. */
+export function workingDaysFromToday(days: number): string {
+  return addWorkingDays(businessDate(new Date()), days);
+}
