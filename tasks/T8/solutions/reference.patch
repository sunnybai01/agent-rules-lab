+    /** Changes the e-mail address. Other modules learn about it through `identity.person-email-changed`. */
+    async changeEmail(personId: string, newEmail: string): Promise<Person> {
+      const person = await repo.findById(personId);
+      if (!person) throw new PersonNotFoundError();
+      const email = newEmail.trim().toLowerCase();
+      if (email === person.email) return person;
+      if (await repo.findByEmail(email)) throw new EmailAlreadyRegisteredError();
+      const changed: Person = { ...person, email };
+      await repo.update(changed);
+      const now = clock.now();
+      const event: PersonEmailChanged = {
+        type: "identity.person-email-changed",
+        id: newId(now),
+        occurredAt: now.toISOString(),
+        payload: { personId: person.id },
+      };
+      await bus.publish(event);
+      return changed;
+    },
